            cs_reveal({_p})
            wait cs_wt({_p}, 30)
        else if {_e} is "misok":
            cs_snd({_p}, "tier_up", 1, 1)
            cs_mfx({_p}, "tierup")
            cs_title({_p}, "&r", "&a&lミッション %{-cs::mis::%{_u}%}% クリア!", 25)
