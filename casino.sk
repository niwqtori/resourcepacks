        else if {_e} is "vstock":
            cs_snd({_p}, "tier_up", 1, 1.2)
            cs_mfx({_p}, "tierup")
            cs_title({_p}, "&r", "&e&lVストック獲得! &f(%{casino::st::%{_sk}%::vs}%個)", 30)
            wait cs_wt({_p}, 16)
        else if {_e} is "drive":
            cs_snd({_p}, "kyuin_rainbow", 1, 1)
            cs_mfx({_p}, "rainbow")
