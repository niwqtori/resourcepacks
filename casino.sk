# ============================================================
#  casino.sk - カジノ (NoName スロット + HADES スロット + Dead or Alive + WANTED MAN + 000Heists + The Pharaoh + カジノ ラウンジ (ルーレット・ブラックジャック・CRASH・MINES・招き猫 FEVER) + メダル両替所)  v9.1
#  必要: Skript 2.17.1 以上 / skript-reflect (Paper 26.3)
#  見た目・音: sk-own リソースパック v15 以上 (HADES は v10・Dead or Alive は v12・WANTED MAN は v14・000Heists は v15・The Pharaoh は v17 (数字の絵は v18) から。無くても動く。音が鳴らず、絵がふつうのアイテムになるだけ)
#
#  /casino              : カジノのGUIを開く (だれでも)
#  /casino admin        : (OP) 両替所の設定GUI (アイテム→メダル / メダル→景品 を登録)
#  /casino give <名前> <枚数> / take <名前> <枚数> / set <名前> <枚数> / medal <名前> : (OP) メダルの操作・確認
#  /casino open <名前>  : (OP) その人にカジノのGUIを開く (NPC・コマンドブロック用)
#  /casino reset <名前> : (OP) その人のスロットの状態 (CZ/AT中など) を通常に戻す
#  /casino build        : (OP) 立っている場所を中心に 15×15×15 のスロット台エリアを建てる (向いている方向に台)
#  /casino build hades  : (OP) 同じように HADES スロットの台を建てる (5リール。冥界の建物)
#  /casino build doa    : (OP) Dead or Alive (HighRoller・1回 15〜150クレ) の台を建てる
#  /casino doaunlock <名前> [all|reset|0-9] : (OP) Dead or Alive の遊び方の解放を変える (プレイヤーごと。たどり着いた段階まで読める)
#  /casino build wanted : (OP) WANTED MAN (HighRoller・1回 15〜150クレ) の台を建てる
#  /casino wmunlock <名前> [all|reset|0-10] : (OP) WANTED MAN の遊び方の解放を変える
#  /casino build heist  : (OP) 000Heists (1回 3〜30クレ・中リスク中リターン) の台を建てる
#  /casino hsunlock <名前> [all|reset|0-10] : (OP) 000Heists の遊び方の解放を変える
#  /casino build roulette / blackjack / crash / mines / neko : (OP) カジノ ラウンジの台 (BET は 1〜1億クレを 好きに決められる・設定なし。v9.0 / BET 自由化 v9.1)
#  /casino build pharaoh : (OP) The Pharaoh (6列×5段・1回 10〜100クレ・オンラインカジノ風) の台を建てる
#  /casino lucky <名前> <1-7> <時間> : (OP) その人が台に座っている間だけ その設定にする (本人には知らせない・OP にだけ通知)。lucky <名前> off で止める / lucky だけで一覧
#  /casino resetbest <名前> : (OP) その人の最高獲得を 全部のスロットで消す (サーバー最高記録を持っていたら それも消す)
#  /casino mr <段階>    : (OP) 座っている WANTED MAN / Dead or Alive / 000Heists の台を、その段階から始める (検証用。/casino mr だけで一覧)
#  /casino autoset [on|off|now|next] : (OP) 全部の台の設定を {@autoset} ごとに自動で変える (初めは ON)。next (か何も付けない) で次の時刻を見る
#  /casino remove       : (OP) 立っているエリアを消して、建てる前の地形に戻す
#  /casino list         : (OP) スロット台エリアの一覧
#  /casino machinereset : (OP) 立っている台のデータ (天井・周期・モード・途中の状態) をリセット
#  ・ハイエナ: 通常時のデータ (天井・周期・ポイント・モード・BET) は台に残る。空き台の上にも表示
#             チャレンジ・ボーナス・ラッシュの途中で離れた台は {@keep} キープ → 過ぎたら誰でも続きを打てる (放置台)
#  /casino forget       : (OP) 立っているエリアの登録だけ消す (ブロックはそのまま。おかしくなったとき用)
#  ・スロットは台を右クリックで遊ぶ (1台に1人まで)。台のランプ・リール・パーティクルが演出に合わせて動く
#
#  /casino setting [1-7] : (OP) 立っている台の設定を見る・変える / setting all <1-7> で全部の台 (+ anywhere 用)
#
#  NoName スロット (1回 3枚 × BET ×1〜×10000) ― 流れ (sim2.py と同じ数字)
#   ・通常時: 1Gごと・レア役でポイント。周期の規定 (100/200/400/600pt) に届くとモード (A/B/C/天国) に応じて
#            覚醒チャレンジ (CZ) の抽選。6周期目は確定。レア役 → 覚醒ゾーン (5G・ポイント大量・10セットで覚醒ボーナス)
#            BAR揃い → BARドライブ (8G・CZ 高確率)。NoName7 揃い = 覚醒ボーナス + ラッシュ確定。1500G でボーナス天井
#   ・覚醒チャレンジ: 11G。成功で 覚醒ボーナス (45G・ラッシュ期待度 約33〜48%) か 決戦ボーナス (9G・ミッション3つ)
#   ・NoName ラッシュ: 純増 約9枚/G。1セット 10〜100G。レア役で上乗せ・覚醒の剣 (Vストック)・NoName ドライブ (+50/+100G)
#            セットの終わりに覚醒ジャッジ (Vストックがあれば成功)。3回成功で 超 NoName ラッシュ (継続 約90%)
#            終わったあと 66G は引き戻し区間。1/8192 のロングフリーズ = 超ラッシュ 20G + Vストック 9
#   ・設定 1〜6 (台ごと): 機械割 約85.5 / 93.5 / 99 / 101 / 102 / 105% (v7.7・シミュレーション 10億G)
#            設定7 = イベント用の設定 (機械割 約180%・ラッシュ 約1/300。v8.4.7〜)
#   ・覚醒チャレンジ・覚醒ボーナスの ★ は どの設定でも同じところから始まる (設定が ★ でばれないように。v7.7)
#            通常時ボーナス 約1/480 (設定1)。設定でチャレンジ成功率・ボーナス→ラッシュ率・ドライブ率・モードが変わる
#
#  HADES スロット (1回 3枚 × BET ×1〜×10000) ― 流れはファイルの下の「HADES スロット」(hades_sim.c と同じ数字)
#   ・設定 1〜7 の機械割 約77 / 85 / 98 / 102 / 110 / 124 / 171% (シミュレーション 1億G)
#   ・H A D E S が揃うと「偃月」(materials.sk の engetsu と同じ素材) がもらえる
#  Dead or Alive ― 流れはファイルの下 (doa_sim.c と同じ数字)。還元率 約50 / 65 / 77 / 88 / 98 / 120 / 150%
#   GOD MODE 約1/5.1万〜1/4300G・GODトロフィー 約1/39万〜1/3.3万G (設定1〜7)
#  WANTED MAN ― 流れはファイルの下 (wm_sim.c と同じ数字)。還元率 約50 / 66 / 77 / 88 / 98 / 120 / 150%
#   指名手配ハンティング 約1/450G (どの設定も)・GOD MODE 約1/45万〜1/9000G・WANTEDトロフィー 約1/136万〜1/2.7万G
#  000Heists ― 流れはファイルの下 (hs_sim.c と同じ数字)。還元率 約80 / 88 / 95 / 100 / 106 / 115 / 130%
#   銀行強盗 約1/380〜1/280G・運命の決断 約1/3.9万〜1/1.5万G・超 (000HEIST トロフィー) 約1/22万〜1/8.4万G (v7.2)
#   v7.2: 運命の決断のあとのラッシュが山場 (1ゲームの純増 BET ×1: 孤独 約+53 / 安定 約+44 / フレンドリー 約+63)
#   v7.4: 裏切り = 高リスク高リターン (成功 33〜38% → 報酬3倍 + 孤独のラッシュ 継続85% (超で95%))
#  The Pharaoh ― 流れはファイルの下 (ph_sim.c と同じ数字)。設定なし・還元率 約99% (購入も同じくらい)
#   フリースピン 約1/260・天井 ×67777倍 = PHARAOH トロフィー (v8.4)
#  /pay <名前> <枚数>   : だれでも。カジノのクレジット (メダル) を ほかの人に渡す (/cpay・/casinopay でも同じ)
#
#  データ: {casino::medal::UUID} = メダル / {casino::st::UUID::*} = スロットの状態 / {casino::stat::UUID::*} = 成績
#          {casino::xin::ID} / {casino::xinp::ID}   = 両替 (このアイテム → メダル何枚)
#          {casino::xout::ID} / {casino::xoutp::ID} = 景品 (メダル何枚 → このアイテム)
# ============================================================

options:
    version: v9.1
    prefix: &8[&5カジノ&8]&r
    # 1ゲームのメダル
    bet: 3
    # この枚数以上でラッシュが終わったら全体に知らせる
    announce: 1000
    # この枚数 × BET の倍率 以上でラッシュが終わったら「スロット第１号のトロフィー」をもらえる (×1 なら 5000枚・×10 なら 50000枚)
    trophy: 5000
    # チャレンジ・ボーナス・ラッシュの途中で台を離れたとき、その人のために台をキープする時間
    keep: 5 minutes
    # Dead or Alive・WANTED MAN の 1回のクレジット (×BET 1〜100) / この枚数以上で終わったら全体に知らせる
    dbet: 15
    dannounce: 10000
    # 000Heists の 1回のクレジット (×BET 1〜100) / この枚数以上で終わったら全体に知らせる
    hbet: 3
    hannounce: 3000
    # The Pharaoh の 1回のクレジット (×BET 1〜100) / この倍率以上で終わったら全体に知らせる
    pbet: 10
    pannounce: 500
    # カジノ ラウンジ (ルーレット・ブラックジャック・CRASH・MINES・招き猫 FEVER) の BET のはじめの額 / BET の上限 (1〜この額を 好きに決められる) / 掛け金のこの倍率以上で全体に知らせる
    tbet: 10
    tbetmax: 100000000
    tannounce: 100
    # The Pharaoh の購入の値段 (1回の何倍か)。設定4 (還元率 99%) の期待値から決めた値段 (ph_sim.c)
    ph1: 100
    ph2: 480
    ph3: 1400
    # 全部の台の設定を自動で変える間隔 (/casino autoset off で止める)
    autoset: 3 hours
    # true にすると /casino のGUIからでも遊べる (false = スロット台でだけ)
    anywhere: false

import:
    org.bukkit.Bukkit
    org.bukkit.NamespacedKey
    org.bukkit.Particle
    org.bukkit.block.Container
    org.bukkit.entity.Enemy
    org.bukkit.entity.Boss
    org.bukkit.block.TileState
    org.bukkit.block.data.Directional
    org.bukkit.event.block.BlockExplodeEvent
    org.bukkit.event.block.BlockFromToEvent
    org.bukkit.event.entity.EntityChangeBlockEvent
    org.bukkit.entity.Display$Brightness as DBright
    java.util.UUID
    org.bukkit.inventory.ItemStack as BItemStack
    java.util.Base64
    java.text.SimpleDateFormat
    java.util.TimeZone
    java.util.Date as JDate
    org.bukkit.entity.EntityType
    org.bukkit.util.EulerAngle
    org.bukkit.entity.Pose
    io.papermc.paper.datacomponent.item.ResolvableProfile
    net.kyori.adventure.text.Component
    org.bukkit.Color as BColor

# ============================================================
#  起動時
# ============================================================

on load:
    # リール (21コマ)
    set {-cs::strip::1::*} to split "7p,replay,bell,cherry,suika,replay,bell,bar,replay,bell,7r,cherry,replay,bell,suika,replay,bell,bar,replay,bell,cherry" at ","
    set {-cs::strip::2::*} to split "7p,bell,replay,suika,bell,replay,bar,bell,replay,cherry,bell,replay,7r,bell,replay,suika,bell,replay,bar,bell,replay" at ","
    set {-cs::strip::3::*} to split "7p,replay,bell,suika,replay,bell,bar,replay,bell,7r,replay,bell,cherry,replay,bell,suika,replay,bell,bar,replay,bell" at ","
    # リロードしたとき: 開いている画面を閉じ (回転中なら結果を反映)、メモリ上の印を消す
    loop all players:
        if {-cs::gui::%uuid of loop-player%} is set:
            close loop-player's inventory
        cs_barremove(loop-player)
    delete {-cs::spin::*}
    delete {-cs::busy::*}
    delete {-cs::hold::*}
    delete {-cs::auto::*}
    delete {-cs::frz::*}
    delete {-cs::seat::*}
    delete {-cs::seatp::*}
    delete {-cs::useat::*}
    delete {-cs::idle::*}
    delete {-cs::job}
    delete {-hd::rs::*}
    delete {-hd::vlv::*}
    delete {-do::rs::*}
    delete {-do::vlv::*}
    delete {-wm::rs::*}
    delete {-wm::vlv::*}
    delete {-hs::rs::*}
    delete {-hs::vlv::*}
    hd_strips()
    do_strips()
    wm_strips()
    hs_strips()
    set {-cs::anywhere} to false
    set {_any} to "{@anywhere}" parsed as boolean
    if {_any} is true:
        set {-cs::anywhere} to true
    loop {casino::areas::*}:
        add 1 to {-cs::amtok::%loop-index%}
        # 建てる途中で止まった・前の版のエラーで保存できていないエリアは、登録だけ消す (ブロックはさわらない)
        if {casino::area::%loop-index%::o::0_0_0} is not set:
            send "[casino] %loop-index%番のエリアは地形の保存が無いので登録を消しました" to console
            delete {casino::areas::%loop-index%}
            delete {casino::area::%loop-index%::*}
    send "[casino] {@version} を読み込みました" to console

# ============================================================
#  アイテム
# ============================================================

# アイテムにリソースパックの見た目を付ける
function cs_it(mat: itemtype, model: text, name: text) :: itemtype:
    set {_i} to 1 of {_mat}
    set name of {_i} to {_name}
    if {_model} is not "":
        set {_m} to {_i}.getItemMeta()
        {_m}.setItemModel(NamespacedKey.fromString("skown:%{_model}%"))
        {_i}.setItemMeta({_m})
    return {_i}

function cs_pane() :: itemtype:
    return cs_it(black stained glass pane, "", "&r ")

# 図柄
function cs_sym(s: text) :: itemtype:
    if {_s} is "7p":
        return cs_it(amethyst shard, "slot_7p", "&d&l7 &5(NoName セブン)")
    if {_s} is "7r":
        return cs_it(red dye, "slot_7r", "&c&l7 &4(赤セブン)")
    if {_s} is "bar":
        return cs_it(black dye, "slot_bar", "&f&lBAR")
    if {_s} is "bell":
        return cs_it(bell, "slot_bell", "&e&lベル")
    if {_s} is "replay":
        return cs_it(light blue dye, "slot_replay", "&b&lリプレイ")
    if {_s} is "suika":
        return cs_it(melon slice, "slot_suika", "&a&lスイカ")
    if {_s} is "cherry":
        return cs_it(sweet berries, "slot_cherry", "&c&lチェリー")
    return cs_it(gray stained glass pane, "slot_reel_blur", "&7回転中…")

# ランプ
function cs_lampitem(k: text) :: itemtype:
    if {_k} is "red":
        return cs_it(red stained glass, "lamp_red", "&r ")
    if {_k} is "gold":
        return cs_it(yellow stained glass, "lamp_gold", "&r ")
    if {_k} is "rainbow":
        return cs_it(magenta stained glass, "lamp_rainbow", "&r ")
    if {_k} is "off":
        return cs_it(gray stained glass, "lamp_off", "&r ")
    if {_k} is "hades":
        return cs_it(red stained glass, "lamp_hades", "&r ")
    if {_k} is "dead":
        return cs_it(green stained glass, "lamp_dead", "&r ")
    if {_k} is "god":
        return cs_it(yellow stained glass, "lamp_god", "&r ")
    if {_k} is "wanted":
        return cs_it(orange stained glass, "lamp_wanted", "&r ")
    if {_k} is "heist":
        return cs_it(blue stained glass, "lamp_heist", "&r ")
    if {_k} is "pharaoh":
        return cs_it(yellow stained glass, "lamp_gold", "&r ")
    return cs_it(purple stained glass, "lamp_purple", "&r ")

# ============================================================
#  メダル
# ============================================================

function cs_med(p: player) :: number:
    set {_n} to {casino::medal::%uuid of {_p}%}
    if {_n} is set:
        return {_n}
    return 0

function cs_addmed(p: player, n: number):
    set {_u} to uuid of {_p}
    if {casino::medal::%{_u}%} is not set:
        set {casino::medal::%{_u}%} to 0
    add {_n} to {casino::medal::%{_u}%}
    if {casino::medal::%{_u}%} < 0:
        set {casino::medal::%{_u}%} to 0

# ============================================================
#  小さな道具 (オフラインでも安全に呼べる)
# ============================================================

function cs_ticks(n: number) :: timespan:
    return "%{_n}% ticks" parsed as timespan

# 爆速モード (演出の待ち時間を短く)。段階: 1 爆速 (1/4) / 2 超爆速 (1/8) / 3 神速 (1/16・リールが全部いっぺんに止まる)
#   画面のボタン: クリック = ON / OFF、右クリック = 段階を切り替え (台では しゃがみ+台を右クリックで ON / OFF)
function cs_fast(p: player) :: boolean:
    if {casino::fast::%uuid of {_p}%} is true:
        return true
    return false

function cs_fastlv(p: player) :: number:
    if cs_fast({_p}) is false:
        return 0
    set {_lv} to {casino::fastlv::%uuid of {_p}%}
    if {_lv} is not set:
        return 1
    return {_lv}

function cs_fastname(lv: number) :: text:
    if {_lv} >= 3:
        return "&d&l神速 &7(演出 1/16・リールが全部いっぺんに止まる)"
    if {_lv} is 2:
        return "&e&l超爆速 &7(演出 1/8)"
    return "&b&l爆速 &7(演出 1/4)"

function cs_wt(p: player, n: number) :: timespan:
    set {_lv} to cs_fastlv({_p})
    if {_lv} > 0:
        set {_d} to 4
        if {_lv} is 2:
            set {_d} to 8
        else if {_lv} >= 3:
            set {_d} to 16
        set {_n} to round({_n} / {_d})
        if {_n} < 1:
            set {_n} to 1
    return cs_ticks({_n})

# 画面の 爆速モードのボタン
function cs_fastitem(p: player) :: itemtype:
    set {_lv} to {casino::fastlv::%uuid of {_p}%}
    if {_lv} is not set:
        set {_lv} to 1
    if cs_fast({_p}) is true:
        set {_fi} to cs_it(feather, "", "&b&l爆速モード: &a&lON &8- %cs_fastname({_lv})%")
        set lore of {_fi} to "&7リールが自動ですぐ止まる・演出が短くなる", "&eクリック: OFF" and "&e右クリック: 速さを変える (爆速 → 超爆速 → 神速)"
    else:
        set {_fi} to cs_it(feather, "", "&b爆速モード: &c&lOFF &8- %cs_fastname({_lv})%")
        set lore of {_fi} to "&7リールが自動ですぐ止まる・演出が短くなる", "&eクリック: ON (台では しゃがみ+台を右クリック)" and "&e右クリック: 速さを変える (爆速 → 超爆速 → 神速)"
    return {_fi}

# 右クリック: 速さを切り替える (ついでに ON にする)
function cs_fastlevel(p: player):
    set {_u} to uuid of {_p}
    set {_lv} to {casino::fastlv::%{_u}%}
    if {_lv} is not set:
        set {_lv} to 1
    if {casino::fast::%{_u}%} is true:
        add 1 to {_lv}
        if {_lv} > 3:
            set {_lv} to 1
    set {casino::fastlv::%{_u}%} to {_lv}
    set {casino::fast::%{_u}%} to true
    send action bar "&b&l爆速モード: &a&lON &8- %cs_fastname({_lv})%" to {_p}
    play sound "ui.button.click" with volume 0.6 and pitch (1.2 + {_lv} * 0.2) to {_p}
    cs_fastbtns({_p})

function cs_fastbtns(p: player):
    cs_btns({_p})
    hd_btns({_p})
    do_btns({_p})
    wm_btns({_p})
    hs_btns({_p})
    ph_btns({_p})

function cs_setfast(p: player):
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    if {casino::fast::%{_u}%} is true:
        delete {casino::fast::%{_u}%}
        send action bar "&b爆速モード: &c&lOFF" to {_p}
    else:
        set {casino::fast::%{_u}%} to true
        send action bar "&b&l爆速モード: &a&lON &8- %cs_fastname(cs_fastlv({_p}))% &7(画面のボタンを右クリックで速さを変える)" to {_p}
    play sound "ui.button.click" with volume 0.6 and pitch 1.5 to {_p}
    cs_fastbtns({_p})

function cs_snd(p: player, s: text, v: number, pi: number):
    if {_p} is online:
        play sound "skown:slot.%{_s}%" with volume {_v} and pitch {_pi} to {_p}

function cs_title(p: player, a: text, b: text, t: number):
    if {_p} is online:
        send title {_a} with subtitle {_b} to {_p} for cs_ticks({_t})

function cs_bar_msg(p: player, a: text):
    if {_p} is online:
        send action bar {_a} to {_p}

# 開いているスロットのGUI (開いていなければ何も返さない)
function cs_slotgui(p: player) :: inventory:
    if {_p} is not online:
        stop
    set {_u} to uuid of {_p}
    if {-cs::gui::%{_u}%} is not set:
        stop
    if {-cs::type::%{_u}%} is not "slot":
        stop
    if {_p}'s current inventory is not {-cs::gui::%{_u}%}:
        stop
    return {-cs::gui::%{_u}%}

# スロットの状態の置き場所: 台に座っていれば その台 ("m台番号")、そうでなければ その人 (UUID)
#  → 通常時のデータ (天井・周期・ポイント・モード・BET) は台に残る = ハイエナできる
function cs_key(p: player) :: text:
    set {_id} to {-cs::useat::%uuid of {_p}%}
    if {_id} is set:
        if {-cs::seat::%{_id}%} is uuid of {_p}:
            return "m%{_id}%"
    return "%uuid of {_p}%"

# 遊んでいる最中か (スロットの画面を開いている or 台に座っている)
function cs_playing(p: player) :: boolean:
    if cs_slotgui({_p}) is set:
        return true
    set {_id} to {-cs::useat::%uuid of {_p}%}
    if {_id} is set:
        if {-cs::seat::%{_id}%} is uuid of {_p}:
            return true
    return false

# 見せる期待度 (設定で変わる 最初の値は隠す。どの設定でも同じところから始まって、上がった分だけ増える)
function cs_czshow(sk: text) :: number:
    set {_sv} to {casino::st::%{_sk}%::sv}
    if {_sv} is not set:
        set {_sv} to 4
    return {casino::st::%{_sk}%::czw} - cs_tbl("czbase", {_sv}) + 50

function cs_bbshow(sk: text) :: number:
    set {_sv} to {casino::st::%{_sk}%::sv}
    if {_sv} is not set:
        set {_sv} to 4
    return {casino::st::%{_sk}%::bbw} - cs_tbl("bbat", {_sv}) + 40

function cs_stars(w: number) :: text:
    set {_n} to floor({_w} / 20) + 1
    if {_n} > 5:
        set {_n} to 5
    set {_t} to "&6"
    loop {_n} times:
        set {_t} to "%{_t}%★"
    set {_t} to "%{_t}%&8"
    loop (5 - {_n}) times:
        set {_t} to "%{_t}%☆"
    return {_t}

# ============================================================
#  状態
#  {casino::st::UUID::mode} = n (通常) / cz (覚醒チャレンジ) / bb (覚醒ボーナス) / rb (決戦ボーナス)
#                             at (NoName ラッシュ) / jg (覚醒ジャッジ)
#  通常時: md (モード A/B/C/H) / pt・tgt (ポイント・周期の規定pt) / cyc (周期 1〜6) / since (ボーナス天井 1500G)
#          zone (cyber = 覚醒ゾーン / bar = BARドライブ) / zg・zs (残りG・セット数) / pbg・pbat・pbsup (引き戻し 66G)
#  CZ: czg・czw・czk / 覚醒ボーナス: bbg・bbw・bbk / 決戦ボーナス: rbg・rbw・rbm (失敗するミッション)
#  ラッシュ: atl (残りG) / sup (超) / vl (Vランプ) / vs (Vストック) / ken (覚醒の剣 残りG) / gain / sets
#  ジャッジ: jg (残りG) / jwin (成功か)
#  このファイルの数字は sim2.py (シミュレーション) と同じ。変えるときは両方そろえる
# ============================================================

# 掛け金の倍率 (1〜100)。通常時は その人の上限 (cs_betcap) まで
#   (チャレンジ・ラッシュの途中は 始まったときの倍率のまま。アイテムを手放しても下がらない)
function cs_mult(p: player) :: number:
    set {_sk} to cs_key({_p})
    set {_b} to {casino::st::%{_sk}%::bet}
    if {_b} is not set:
        return 1
    if {_b} < 1:
        return 1
    if {_b} > 10000:
        set {_b} to 10000
    set {_m} to {casino::st::%{_sk}%::mode}
    if {_m} is not set:
        set {_m} to "n"
    if {_m} is "n":
        set {_cap} to cs_betcap({_p})
        if {_b} > {_cap}:
            return {_cap}
    return {_b}

# BET の上限: ふつうは ×10。持ち物にあるアイテム (materials.sk) で上がる (いちばん高いものが効く)
#   ギャンブラーの魂 ×20 / セミプロギャンブラーの魂 ×30 / プロギャンブラーの魂 ×50 / 呪われた壺 ×100 / あやしいふしぎなつぼ。 ×200 / 黄金の大つぼ ×300 / 星のつぼ ×500 / 破滅のつぼ ×1000 / 縺ｵ縺ノ壺 (異世界のつぼ) ×10000
#   (1秒ごとに 持ち物を見直す)
function cs_betcap(p: player) :: number:
    set {_u} to uuid of {_p}
    if {-cs::capt::%{_u}%} is set:
        if difference between now and {-cs::capt::%{_u}%} < 1 second:
            return {-cs::cap::%{_u}%}
    set {_c} to 10
    loop 41 times:
        set {_i} to slot ((loop-number) - 1) of {_p}'s inventory
        if {_i} is echo shard or nautilus shell:
            if custom nbt of {_i} has tag "material":
                set {_id} to string tag "material" of custom nbt of {_i}
                if {_id} is "glitch_pot":
                    set {_c} to 10000
                else if {_id} is "ruin_pot":
                    if {_c} < 1000:
                        set {_c} to 1000
                else if {_id} is "star_pot":
                    if {_c} < 500:
                        set {_c} to 500
                else if {_id} is "golden_pot":
                    if {_c} < 300:
                        set {_c} to 300
                else if {_id} is "mystery_pot":
                    if {_c} < 200:
                        set {_c} to 200
                else if {_id} is "cursed_pot":
                    if {_c} < 100:
                        set {_c} to 100
                else if {_id} is "pro_soul":
                    if {_c} < 50:
                        set {_c} to 50
                else if {_id} is "semipro_soul":
                    if {_c} < 30:
                        set {_c} to 30
                else if {_id} is "gambler_soul":
                    if {_c} < 20:
                        set {_c} to 20
    set {-cs::cap::%{_u}%} to {_c}
    set {-cs::capt::%{_u}%} to now
    return {_c}

# 次の倍率: d = +1 (上げる) / -1 (下げる) / 10 (上限) / -10 (×1)。段は 1 2 3 5 10 20 30 50 100 200 300 500 1000 10000 (上限 cap まで)
function cs_betnext(b: number, d: number, cap: number) :: number:
    if {_d} >= 10:
        return {_cap}
    if {_d} <= -10:
        return 1
    set {_l::*} to 1, 2, 3, 5, 10, 20, 30, 50, 100, 200, 300, 500, 1000 and 10000
    if {_d} > 0:
        loop {_l::*}:
            if loop-value > {_b}:
                if loop-value <= {_cap}:
                    return loop-value
        return 1
    set {_r} to {_cap}
    set {_f} to false
    loop {_l::*}:
        if loop-value < {_b}:
            if loop-value <= {_cap}:
                set {_r} to loop-value
                set {_f} to true
    if {_f} is false:
        return {_cap}
    return {_r}

# 1回の基本の掛け金 (BET ×1 のとき)
function cs_betbase(p: player) :: number:
    if tb_on({_p}) is true:
        return {@tbet}
    if ph_on({_p}) is true:
        return {@pbet}
    if hs_on({_p}) is true:
        return {@hbet}
    if wm_on({_p}) is true:
        return {@dbet}
    if do_on({_p}) is true:
        return {@dbet}
    return {@bet}

# 掛け金を変える (通常時・止まっているときだけ)。d = +1 / -1 / 10 / -10
function cs_setbet(p: player, d: number):
    if tb_on({_p}) is true:
        tb_setbet({_p}, {_d})
        stop
    if ph_on({_p}) is true:
        ph_setbet({_p}, {_d})
        stop
    if hs_on({_p}) is true:
        hs_setbet({_p}, {_d})
        stop
    if wm_on({_p}) is true:
        wm_setbet({_p}, {_d})
        stop
    if do_on({_p}) is true:
        do_setbet({_p}, {_d})
        stop
    if hd_on({_p}) is true:
        hd_setbet({_p}, {_d})
        stop
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    cs_init({_p})
    if {-cs::spin::%{_u}%} is true:
        stop
    if {-cs::busy::%{_u}%} is true:
        stop
    if {-cs::hold::%{_u}%} is true:
        stop
    if {casino::st::%{_sk}%::pr} is set:
        stop
    if {casino::st::%{_sk}%::mode} is not "n":
        send action bar "&cチャレンジ・ボーナス・ラッシュ中は掛け金を変えられません &7(BET ×%cs_mult({_p})%)" to {_p}
        stop
    if {casino::st::%{_sk}%::zone} is not "":
        send action bar "&c覚醒ゾーン・BARドライブ中は掛け金を変えられません" to {_p}
        stop
    if {casino::st::%{_sk}%::pbg} > 0:
        send action bar "&c引き戻し区間中は掛け金を変えられません &7(あと %{casino::st::%{_sk}%::pbg}%G)" to {_p}
        stop
    set {_b} to cs_betnext(cs_mult({_p}), {_d}, cs_betcap({_p}))
    if {_b} is cs_mult({_p}):
        stop
    set {casino::st::%{_sk}%::bet} to {_b}
    # ×1 で周期・天井の手前まで回して ×10 に上げる、ができないように、ポイント・周期・天井をリセット
    set {_rs} to ""
    if {casino::st::%{_sk}%::since} > 0:
        set {_rs} to " &c(ポイント・周期・天井はリセット)"
    set {casino::st::%{_sk}%::since} to 0
    set {casino::st::%{_sk}%::pt} to 0
    set {casino::st::%{_sk}%::cyc} to 1
    set {casino::st::%{_sk}%::tgt} to cs_cyc()
    send action bar "&e&lBET ×%{_b}% &7(1回 %{_b} * {@bet}%枚・払い出しも ×%{_b}%)%{_rs}%" to {_p}
    set {_pi} to 0.6 + ({_b} * 0.12)
    play sound "block.note_block.hat" with volume 0.7 and pitch {_pi} to {_p}
    cs_draw({_p})

function cs_init(p: player):
    if tb_on({_p}) is true:
        tb_init({_p})
        stop
    if ph_on({_p}) is true:
        ph_init({_p})
        stop
    if hs_on({_p}) is true:
        hs_init({_p})
        stop
    if wm_on({_p}) is true:
        wm_init({_p})
        stop
    if do_on({_p}) is true:
        do_init({_p})
        stop
    if hd_on({_p}) is true:
        hd_init({_p})
        stop
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    if {casino::st::%{_sk}%::mode} is not set:
        set {casino::st::%{_sk}%::mode} to "n"
    # v1 のときの状態 (決戦チャレンジ・継続率つきラッシュ) は、新しい仕組みに合わせる
    if {casino::st::%{_sk}%::tier} is set:
        if {casino::st::%{_sk}%::mode} is "cz":
            set {_cb} to cs_tbl("czbase", cs_setting({_p}))
            if {casino::st::%{_sk}%::czw} < {_cb}:
                set {casino::st::%{_sk}%::czw} to {_cb}
        delete {casino::st::%{_sk}%::tier}
        delete {casino::st::%{_sk}%::kk}
        if {casino::st::%{_sk}%::set} is set:
            set {casino::st::%{_sk}%::sets} to {casino::st::%{_sk}%::set}
            delete {casino::st::%{_sk}%::set}
    if {casino::st::%{_sk}%::md} is not set:
        set {casino::st::%{_sk}%::md} to cs_newmode(cs_setting({_p}))
    if {casino::st::%{_sk}%::tgt} is not set:
        set {casino::st::%{_sk}%::tgt} to cs_cyc()
    if {casino::st::%{_sk}%::cyc} is not set:
        set {casino::st::%{_sk}%::cyc} to 1
    if {casino::st::%{_sk}%::zone} is not set:
        set {casino::st::%{_sk}%::zone} to ""
    loop split "pt,since,zg,zs,czg,czw,bbg,bbw,rbg,rbm,atl,vl,vs,ken,gain,sets,jg,pbg" at ",":
        if {casino::st::%{_sk}%::%loop-value%} is not set:
            set {casino::st::%{_sk}%::%loop-value%} to 0
    loop split "czk,bbk,rbw,sup,jwin,pbsup" at ",":
        if {casino::st::%{_sk}%::%loop-value%} is not set:
            set {casino::st::%{_sk}%::%loop-value%} to false
    if {casino::st::%{_sk}%::pbat} is not set:
        set {casino::st::%{_sk}%::pbat} to -1
    loop split "games,in,out,at,best,freeze,cz,bb,rb,sup" at ",":
        if {casino::stat::%{_u}%::%loop-value%} is not set:
            set {casino::stat::%{_u}%::%loop-value%} to 0

# ============================================================
#  設定 (1〜6、7 = イベント用の爆裂設定)。台ごと。台を使っていないとき (anywhere) は全体の設定
# ============================================================

function cs_setting(p: player) :: number:
    set {_id} to {-cs::useat::%uuid of {_p}%}
    # (OP の /casino lucky) その人が台に座っている間だけ 決めた設定 (本人には分からない)
    if {_id} is set:
        set {_lk} to cs_lucky({_p})
        if {_lk} > 0:
            return {_lk}
    if {_id} is set:
        set {_s} to {casino::area::%{_id}%::set}
    else:
        set {_s} to {casino::setting}
    if {_s} is not set:
        return 1
    if {_s} < 1:
        return 1
    if {_s} > 7:
        return 7
    return {_s}

# /casino lucky: その人の設定 (時間内なら 1〜7 / なければ 0)
function cs_lucky(p: player) :: number:
    set {_u} to uuid of {_p}
    set {_lk} to {casino::lucky::%{_u}%}
    if {_lk} is not set:
        return 0
    set {_ut} to {casino::luckyuntil::%{_u}%}
    if {_ut} is not set:
        cs_luckyend("%{_u}%", "時間切れ")
        return 0
    if now >= {_ut}:
        cs_luckyend("%{_u}%", "時間切れ")
        return 0
    return {_lk}

function cs_luckyend(u: text, why: text):
    if {casino::lucky::%{_u}%} is not set:
        stop
    set {_n} to {casino::luckyname::%{_u}%}
    set {_lk} to {casino::lucky::%{_u}%}
    delete {casino::lucky::%{_u}%}
    delete {casino::luckyuntil::%{_u}%}
    delete {casino::luckyname::%{_u}%}
    cs_opnotify("&7(OP) &e%{_n}% &7の lucky (設定%{_lk}%) が終わりました &8(%{_why}%)")

# OP にだけ知らせる (コンソールにも)
function cs_opnotify(t: text):
    send "[casino] %uncolored {_t}%" to console
    loop all players:
        if loop-player is op:
            send "{@prefix} %{_t}%" to loop-player

# チャレンジ・ボーナス・ラッシュ中は、始まった台の設定のまま (台を移っても変わらない)
function cs_setv(p: player) :: number:
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    if {casino::st::%{_sk}%::mode} is not "n":
        if {casino::st::%{_sk}%::sv} is set:
            return {casino::st::%{_sk}%::sv}
    return cs_setting({_p})

# 設定ごとの数字
function cs_tbl(name: text, s: number) :: number:
    if {_name} is "czbase":
        set {_l::*} to 38, 45, 48, 49, 50, 51 and 74
    else if {_name} is "bbat":
        set {_l::*} to 19, 30, 35, 37, 38, 41 and 78.5
    else if {_name} is "rbat":
        set {_l::*} to 12.5, 22, 27, 29, 30, 32 and 66
    else if {_name} is "drive":
        set {_l::*} to 0, 4, 7, 8, 8, 9 and 27
    else if {_name} is "mA":
        set {_l::*} to 67.5, 57.8, 52.8, 51.1, 50.3, 48 and 13.8
    else if {_name} is "mB":
        set {_l::*} to 23.3, 26.2, 27.7, 28.2, 28.5, 29.2 and 39.3
    else if {_name} is "mC":
        set {_l::*} to 8.4, 13, 15.4, 16.3, 16.6, 17.7 and 34.2
    else if {_name} is "jn":
        set {_l::*} to 34, 37.5, 39.5, 40, 40.5, 41 and 54
    else if {_name} is "jsup":
        set {_l::*} to 60, 63.5, 65.5, 66, 66.5, 67 and 80
    else if {_name} is "pb":
        set {_l::*} to 1.4, 2.5, 3, 3.2, 3.3, 3.6 and 7.35
    else:
        return 0
    return {_l::%{_s}%}

# 通常時のモード (A/B/C/天国)。周期到達で CZ に入る確率が違う
function cs_newmode(s: number) :: text:
    set {_r} to random number between 0 and 100
    set {_a} to cs_tbl("mA", {_s})
    set {_b} to {_a} + cs_tbl("mB", {_s})
    set {_c} to {_b} + cs_tbl("mC", {_s})
    if {_r} < {_a}:
        return "A"
    if {_r} < {_b}:
        return "B"
    if {_r} < {_c}:
        return "C"
    return "H"

function cs_modecz(md: text) :: number:
    if {_md} is "H":
        return 100
    if {_md} is "C":
        return 45
    if {_md} is "B":
        return 26
    return 12

# 周期の規定ポイント
function cs_cyc() :: number:
    set {_r} to random number between 0 and 100
    if {_r} < 25:
        return 100
    if {_r} < 60:
        return 200
    if {_r} < 88:
        return 400
    return 600

# ラッシュ 1セットのゲーム数
function cs_setlen() :: number:
    set {_r} to random number between 0 and 100
    if {_r} < 55:
        return 10
    if {_r} < 85:
        return 20
    if {_r} < 95:
        return 30
    if {_r} < 99:
        return 50
    return 100

# NoName ドライブの上乗せ
function cs_drive() :: number:
    if chance of 30%:
        return 100
    return 50

# ============================================================
#  抽選
# ============================================================

# 通常時・CZ中の小役 (1000分の): リプレイ137 / ベル100 / チェリー21 / スイカ16 / 中段チェリー5 / チャンス目6 / BAR5 / NoName7 0.25
function cs_role() :: text:
    set {_r} to random number between 0 and 1000
    if {_r} < 137:
        return "replay"
    if {_r} < 237:
        return "bell"
    if {_r} < 258:
        return "wcherry"
    if {_r} < 274:
        return "suika"
    if {_r} < 279:
        return "scherry"
    if {_r} < 285:
        return "chance"
    if {_r} < 290:
        return "bar"
    if {_r} < 290.25:
        return "nn7"
    return "none"

# ボーナス・ラッシュ・ジャッジ中 (1000分の): リプレイ150 / チェリー40 / スイカ30 / 中段チェリー8 / チャンス目8 / BAR5 / 赤7 0.5 / NoName7 0.1 / のこりベル
function cs_atrole() :: text:
    set {_r} to random number between 0 and 1000
    if {_r} < 150:
        return "replay"
    if {_r} < 190:
        return "wcherry"
    if {_r} < 220:
        return "suika"
    if {_r} < 228:
        return "scherry"
    if {_r} < 236:
        return "chance"
    if {_r} < 241:
        return "bar"
    if {_r} < 241.5:
        return "red7"
    if {_r} < 241.6:
        return "nn7"
    return "bell"

# レア役 (ポイント・CZ・ボーナスに効く4つ)
function cs_rare(r: text) :: boolean:
    if {_r} is "wcherry" or "suika" or "scherry" or "chance":
        return true
    return false

# 目立つ役 (止めたときの音・表示用)
function cs_flashy(r: text) :: boolean:
    if cs_rare({_r}) is true:
        return true
    if {_r} is "bar" or "red7" or "nn7" or "freeze":
        return true
    return false

# 払い出し (BET ×1 のとき)。m = そのゲームの状態
function cs_pay(r: text, m: text) :: number:
    if {_r} is "replay":
        return 3
    if {_r} is "wcherry" or "scherry":
        return 2
    if {_r} is "suika":
        return 6
    if {_r} is "chance":
        return 4
    if {_m} is "at" or "jg":
        if {_r} is "bell" or "red7" or "nn7":
            return 15
        if {_r} is "bar":
            return 6
        return 0
    if {_m} is "bb" or "rb":
        if {_r} is "bell" or "red7" or "nn7":
            return 12
        if {_r} is "bar":
            return 6
        return 0
    if {_r} is "bell":
        return 9
    if {_r} is "bar":
        return 3
    return 0

function cs_ptrare(r: text) :: number:
    if {_r} is "wcherry":
        return 5
    if {_r} is "suika":
        return 10
    if {_r} is "scherry":
        return 20
    if {_r} is "chance":
        return 15
    return 0

function cs_zonein(r: text) :: number:
    if {_r} is "wcherry":
        return 5
    if {_r} is "suika":
        return 8
    if {_r} is "scherry":
        return 25
    if {_r} is "chance":
        return 20
    return 0

function cs_rolename(r: text) :: text:
    if {_r} is "replay":
        return "&bリプレイ"
    if {_r} is "bell":
        return "&eベル"
    if {_r} is "wcherry":
        return "&cチェリー"
    if {_r} is "scherry":
        return "&c&l中段チェリー"
    if {_r} is "suika":
        return "&aスイカ"
    if {_r} is "chance":
        return "&6&lチャンス目"
    if {_r} is "bar":
        return "&f&lBAR揃い"
    if {_r} is "nn7" or "freeze":
        return "&d&lNoName7 揃い"
    if {_r} is "red7":
        return "&c&l赤7揃い"
    return ""

# ============================================================
#  リール
# ============================================================

# リール r の中で、図柄 s がある位置 (1〜21) を1つ
function cs_find(r: number, s: text) :: number:
    loop {-cs::strip::%{_r}%::*}:
        if loop-value is {_s}:
            add (loop-index parsed as number) to {_c::*}
    if size of {_c::*} is 0:
        return 1
    return random element out of {_c::*}

# 5ライン: 0=上段 1=中段 2=下段 3=右下がり 4=右上がり (各リールの段: 0上 1中 2下)
function cs_lrow(l: number, r: number) :: number:
    if {_l} is 3:
        return {_r} - 1
    if {_l} is 4:
        return 3 - {_r}
    return {_l}

function cs_linename(l: number) :: text:
    if {_l} is 0:
        return "上段"
    if {_l} is 2:
        return "下段"
    if {_l} is 3:
        return "右下がり"
    if {_l} is 4:
        return "右上がり"
    return "中段"

# リール r の段 k (0上 1中 2下) に見えている図柄
function cs_cell(u: text, r: number, k: number) :: text:
    set {_n} to size of {-cs::strip::%{_r}%::*}
    set {_i} to {-cs::pos::%{_u}%::%{_r}%} + {_k} - 1
    if {_i} < 1:
        add {_n} to {_i}
    if {_i} > {_n}:
        remove {_n} from {_i}
    return {-cs::strip::%{_r}%::%{_i}%}

# 段 k に図柄 s が来る位置
function cs_findrow(r: number, s: text, k: number) :: number:
    set {_n} to size of {-cs::strip::%{_r}%::*}
    set {_i} to cs_find({_r}, {_s}) + 1 - {_k}
    if {_i} < 1:
        add {_n} to {_i}
    if {_i} > {_n}:
        remove {_n} from {_i}
    return {_i}

# 見えている 3×3 から、そろっている役を調べる (左リールのチェリーは どの段でも役)
function cs_judge(u: text) :: texts:
    set {_r::*} to "-"
    loop 5 times:
        set {_l} to (loop-number) - 1
        set {_a} to cs_cell({_u}, 1, cs_lrow({_l}, 1))
        set {_b} to cs_cell({_u}, 2, cs_lrow({_l}, 2))
        set {_c} to cs_cell({_u}, 3, cs_lrow({_l}, 3))
        if {_a} is {_b}:
            if {_b} is {_c}:
                if {_a} is not "cherry":
                    add "%{_a}%" to {_r::*}
        if {_a} is "7r":
            if {_b} is "bar":
                if {_c} is "7p":
                    add "chance" to {_r::*}
    loop 3 times:
        if cs_cell({_u}, 1, (loop-number) - 1) is "cherry":
            add "cherry" to {_r::*}
    return {_r::*}

# 小役から止まる位置を決める (5ラインのどこかにそろえる。ほかの役がまちがってそろわないように)
function cs_setline(p: player, role: text):
    set {_u} to "%uuid of {_p}%"
    set {_want} to "-"
    if {_role} is "replay" or "bell" or "suika":
        set {_want} to {_role}
    else if {_role} is "wcherry" or "scherry":
        set {_want} to "cherry"
    else if {_role} is "chance":
        set {_want} to "chance"
    else if {_role} is "kakutei" or "freeze" or "nn7":
        set {_want} to "7p"
    else if {_role} is "red7":
        set {_want} to "7r"
    else if {_role} is "bar":
        set {_want} to "bar"
    set {_ok} to false
    loop 80 times:
        set {_line} to random integer between 0 and 4
        if {_role} is "wcherry":
            # 角チェリー (左リールの上段か下段)
            set {_k} to random element out of 0 and 2
            set {-cs::pos::%{_u}%::1} to cs_findrow(1, "cherry", {_k})
            set {-cs::pos::%{_u}%::2} to random integer between 1 and 21
            set {-cs::pos::%{_u}%::3} to random integer between 1 and 21
            set {_line} to -1
        else if {_role} is "scherry":
            # 中段チェリー
            set {-cs::pos::%{_u}%::1} to cs_findrow(1, "cherry", 1)
            set {-cs::pos::%{_u}%::2} to random integer between 1 and 21
            set {-cs::pos::%{_u}%::3} to random integer between 1 and 21
            set {_line} to 1
        else if {_want} is "-":
            set {-cs::pos::%{_u}%::1} to random integer between 1 and 21
            set {-cs::pos::%{_u}%::2} to random integer between 1 and 21
            set {-cs::pos::%{_u}%::3} to random integer between 1 and 21
            set {_line} to -1
        else:
            set {_s1} to {_want}
            set {_s2} to {_want}
            set {_s3} to {_want}
            if {_want} is "chance":
                set {_s1} to "7r"
                set {_s2} to "bar"
                set {_s3} to "7p"
            set {-cs::pos::%{_u}%::1} to cs_findrow(1, {_s1}, cs_lrow({_line}, 1))
            set {-cs::pos::%{_u}%::2} to cs_findrow(2, {_s2}, cs_lrow({_line}, 2))
            set {-cs::pos::%{_u}%::3} to cs_findrow(3, {_s3}, cs_lrow({_line}, 3))
        # 確かめる: そろっている役が ちょうど 欲しい役だけ か
        delete {_got::*}
        loop cs_judge({_u}):
            if loop-value-2 is not "-":
                set {_got::%loop-value-2%} to true
        set {_ok} to false
        if {_want} is "-":
            if size of {_got::*} is 0:
                set {_ok} to true
        else if size of {_got::*} is 1:
            if {_got::%{_want}%} is true:
                set {_ok} to true
        if {_ok} is true:
            exit loop
    if {_ok} is false:
        # 80回でだめなら、中段にそろえる (ほぼ起きない)
        set {_line} to 1
        if {_want} is "-":
            set {-cs::pos::%{_u}%::1} to cs_findrow(1, "bar", 1)
            set {-cs::pos::%{_u}%::2} to cs_findrow(2, "bell", 1)
            set {-cs::pos::%{_u}%::3} to cs_findrow(3, "replay", 1)
    set {-cs::line::%{_u}%} to {_line}

# リール r を描く (回っていればブレ、止まっていれば図柄3つ)
function cs_reel(p: player, r: number):
    cs_mreel({_p}, {_r})
    set {_g} to cs_slotgui({_p})
    if {_g} is not set:
        stop
    set {_u} to uuid of {_p}
    set {_moving} to false
    if {-cs::spin::%{_u}%} is true:
        if {-cs::rs::%{_u}%::%{_r}%} is not true:
            set {_moving} to true
    if {_moving} is true:
        set {_bl} to cs_sym("blur")
        set slot (2 + {_r}) of {_g} to {_bl}
        set slot (11 + {_r}) of {_g} to {_bl}
        set slot (20 + {_r}) of {_g} to {_bl}
        stop
    set {_i} to {-cs::pos::%{_u}%::%{_r}%}
    if {_i} is not set:
        set {_i} to random integer between 1 and 21
        set {-cs::pos::%{_u}%::%{_r}%} to {_i}
    set {_n} to size of {-cs::strip::%{_r}%::*}
    set {_t} to {_i} - 1
    if {_t} < 1:
        set {_t} to {_n}
    set {_b} to {_i} + 1
    if {_b} > {_n}:
        set {_b} to 1
    set slot (2 + {_r}) of {_g} to cs_sym({-cs::strip::%{_r}%::%{_t}%})
    set slot (11 + {_r}) of {_g} to cs_sym({-cs::strip::%{_r}%::%{_i}%})
    set slot (20 + {_r}) of {_g} to cs_sym({-cs::strip::%{_r}%::%{_b}%})

# ============================================================
#  画面 (スロット)
#   0 8 9 17 18 26 27 35 36 44 45 53 = ランプ
#   3〜5 / 12〜14 / 21〜23 = リール (真ん中の段がライン)
#   30 31 32 = ストップボタン / 40 = レバー / 37 = クレジット / 43 = オート
#   10 = 状態 / 16 = ゲーム数 / 46 = 戻る / 48 = 遊び方 / 50 = データ
# ============================================================

function cs_lampkind(p: player) :: text:
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    set {_m} to {casino::st::%{_sk}%::mode}
    if {_m} is "at":
        if {casino::st::%{_sk}%::sup} is true:
            return "rainbow"
        return "gold"
    if {_m} is "bb":
        return "gold"
    if {_m} is "cz" or "rb" or "jg":
        return "red"
    if {casino::st::%{_sk}%::zone} is "cyber":
        return "gold"
    if {casino::st::%{_sk}%::zone} is "bar":
        return "red"
    return "purple"

function cs_lamps(p: player, k: text):
    cs_mlamps({_p}, {_k})
    set {_g} to cs_slotgui({_p})
    if {_g} is not set:
        stop
    set {_i} to cs_lampitem({_k})
    loop 6 times:
        set slot (((loop-number) - 1) * 9) of {_g} to {_i}
        set slot (((loop-number) - 1) * 9 + 8) of {_g} to {_i}

# 2色を交互に光らせる (n 回、t tick ずつ)。終わったら状態の色に戻す
function cs_flash(p: player, a: text, b: text, n: number, t: number):
    set {_u} to uuid of {_p}
    add 1 to {-cs::ftok::%{_u}%}
    set {_tok} to {-cs::ftok::%{_u}%}
    loop {_n} times:
        if {-cs::ftok::%{_u}%} is not {_tok}:
            stop
        if mod(loop-number, 2) is 1:
            cs_lamps({_p}, {_a})
        else:
            cs_lamps({_p}, {_b})
        wait cs_ticks({_t})
    if {-cs::ftok::%{_u}%} is {_tok}:
        if {_p} is online:
            if {-cs::hold::%{_u}%} is not true:
                cs_lamps({_p}, cs_lampkind({_p}))

# 今の状態を3行で (GUI・ボスバー・台の上の文字で使う)
function cs_status(p: player) :: texts:
    return cs_statusk(cs_key({_p}))

# 状態を3行で (sk = 状態の置き場所)
function cs_statusk(sk: text) :: texts:
    set {_m} to {casino::st::%{_sk}%::mode}
    if {_m} is "at":
        set {_t} to "&d&lNoName ラッシュ"
        if {casino::st::%{_sk}%::sup} is true:
            set {_t} to "&6&l超 NoName ラッシュ"
        set {_vl} to ""
        if {casino::st::%{_sk}%::sup} is true:
            set {_vl} to "&6●●●"
        else:
            loop 3 times:
                if loop-number <= {casino::st::%{_sk}%::vl}:
                    set {_vl} to "%{_vl}%&a●"
                else:
                    set {_vl} to "%{_vl}%&8○"
        set {_l2} to "&f%{casino::st::%{_sk}%::sets}%セット目 &7| &f残り &e%{casino::st::%{_sk}%::atl}%G"
        set {_l3} to "&7V %{_vl}% &7| &eVストック %{casino::st::%{_sk}%::vs}% &7| &6+%{casino::st::%{_sk}%::gain}%枚"
        if {casino::st::%{_sk}%::ken} > 0:
            set {_l3} to "&c&l覚醒の剣 &f残り%{casino::st::%{_sk}%::ken}%G &7| &eVストック %{casino::st::%{_sk}%::vs}%"
        return {_t}, {_l2} and {_l3}
    if {_m} is "jg":
        return "&c&l覚醒ジャッジ", "&f残り %{casino::st::%{_sk}%::jg}%G" and "&7%{casino::st::%{_sk}%::sets}%セット目の継続をかけて"
    if {_m} is "cz":
        return "&c&l覚醒チャレンジ", "&f残り %{casino::st::%{_sk}%::czg}%G" and "&7期待度 %cs_stars(cs_czshow({_sk}))%"
    if {_m} is "bb":
        return "&e&l覚醒ボーナス", "&f残り %{casino::st::%{_sk}%::bbg}%G" and "&7ラッシュ期待度 %cs_stars(cs_bbshow({_sk}))%"
    if {_m} is "rb":
        set {_done} to floor((9 - {casino::st::%{_sk}%::rbg}) / 3)
        return "&c&l決戦ボーナス", "&f残り %{casino::st::%{_sk}%::rbg}%G" and "&7ミッション %{_done}%/3"
    set {_t} to "&5&lNoName スロット"
    set {_l2} to "&f周期 &e%{casino::st::%{_sk}%::cyc}%&7/6 &7| &b%{casino::st::%{_sk}%::pt}%&7/%{casino::st::%{_sk}%::tgt}%pt"
    set {_l3} to "&7ボーナス天井まで %1500 - {casino::st::%{_sk}%::since}%G"
    if {casino::st::%{_sk}%::zone} is "cyber":
        set {_l3} to "&b&l覚醒ゾーン &f%{casino::st::%{_sk}%::zs}%セット目 残り%{casino::st::%{_sk}%::zg}%G"
    else if {casino::st::%{_sk}%::zone} is "bar":
        set {_l3} to "&6&lBARドライブ &f残り%{casino::st::%{_sk}%::zg}%G"
    else if {casino::st::%{_sk}%::pbg} > 0:
        set {_l3} to "&a引き戻し区間 &fあと%{casino::st::%{_sk}%::pbg}%G"
    return {_t}, {_l2} and {_l3}

# ボタン類 (ストップ・レバー・クレジット・BET・オート)
function cs_btns(p: player):
    set {_g} to cs_slotgui({_p})
    if {_g} is not set:
        stop
    set {_u} to uuid of {_p}
    loop 3 times:
        set {_lit} to false
        if {-cs::spin::%{_u}%} is true:
            if {-cs::rs::%{_u}%::%loop-number%} is not true:
                set {_lit} to true
        if {_lit} is true:
            set {_s} to cs_it(stone button, "slot_stop_lit", "&e&lSTOP %loop-number%")
            set lore of {_s} to "&eクリックで止める"
        else:
            set {_s} to cs_it(stone button, "slot_stop", "&7STOP %loop-number%")
        set slot (29 + loop-number) of {_g} to {_s}
    set {_mu} to cs_mult({_p})
    set {_bt} to cs_it(gold nugget, "slot_bet", "&e&lBET ×%{_mu}% &7(1回 %{_mu} * {@bet}%枚)")
    set lore of {_bt} to "&7払い出しも ×%{_mu}%", "&eクリック: 上げる / 右クリック: 下げる &8(1・2・3・5・10・20・30・50・100…)", "&eシフト+クリック: 上限 / シフト+右クリック: ×1", "&7あなたの上限: &e×%cs_betcap({_p})% &8(ふつう ×10。魂・壺を持つと上がる)", "&c変えるとポイント・周期・天井はリセット" and "&8(通常時のゾーン・引き戻し以外のときだけ)"
    set slot 38 of {_g} to {_bt}
    set {_lv} to cs_it(lever, "slot_lever", "&c&lレバー &7(1回 %{_mu} * {@bet}%枚)")
    if {-cs::spin::%{_u}%} is true:
        set lore of {_lv} to "&7回転中…"
    else if {-cs::busy::%{_u}%} is true:
        set lore of {_lv} to "&7演出中…"
    else:
        set lore of {_lv} to "&eクリックで回す"
    set slot 40 of {_g} to {_lv}
    set {_cr} to cs_it(gold nugget, "casino_medal", "&6&lクレジット &f%cs_med({_p})%枚")
    set lore of {_cr} to "&7メダルは「両替所」で手に入る"
    set slot 37 of {_g} to {_cr}
    if {-cs::auto::%{_u}%} is true:
        set {_au} to cs_it(clock, "", "&bオートプレイ: &a&lON")
        set lore of {_au} to "&7クリックで OFF"
    else:
        set {_au} to cs_it(clock, "", "&bオートプレイ: &c&lOFF")
        set lore of {_au} to "&7クリックで ON (レバーもストップも自動)"
    set slot 43 of {_g} to {_au}
    set slot 52 of {_g} to cs_fastitem({_p})

# 状態・データ
function cs_info(p: player):
    set {_g} to cs_slotgui({_p})
    if {_g} is not set:
        stop
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    set {_st::*} to cs_status({_p})
    set {_m} to {casino::st::%{_sk}%::mode}
    set {_mat} to amethyst cluster
    if {_m} is "at":
        set {_mat} to nether star
    else if {_m} is "bb":
        set {_mat} to gold block
    else if {_m} is "cz" or "rb" or "jg":
        set {_mat} to iron sword
    set {_i} to cs_it({_mat}, "", {_st::1})
    set lore of {_i} to {_st::2} and {_st::3}
    set slot 10 of {_g} to {_i}
    set {_gm} to cs_it(paper, "", "&fボーナス天井まで &e%1500 - {casino::st::%{_sk}%::since}%G")
    set lore of {_gm} to "&7ポイントが周期の規定に届くと 覚醒チャレンジ の抽選", "&76周期目・1500G (ボーナス・ラッシュ間) で天井" and "&7BET ×%cs_mult({_p})%"
    set slot 16 of {_g} to {_gm}
    set {_sd} to cs_it(writable book, "", "&fデータ")
    set {_in} to {casino::stat::%{_u}%::in}
    set {_out} to {casino::stat::%{_u}%::out}
    set {_wari} to 0
    if {_in} > 0:
        set {_wari} to round({_out} / {_in} * 1000) / 10
    set lore of {_sd} to "&7総ゲーム数: &f%{casino::stat::%{_u}%::games}%G", "&7チャレンジ %{casino::stat::%{_u}%::cz}%回 / 覚醒ボーナス %{casino::stat::%{_u}%::bb}%回 / 決戦ボーナス %{casino::stat::%{_u}%::rb}%回", "&7ラッシュ: &f%{casino::stat::%{_u}%::at}%回 &7(超 %{casino::stat::%{_u}%::sup}%回・フリーズ %{casino::stat::%{_u}%::freeze}%回)", "&7最高獲得: &6%{casino::stat::%{_u}%::best}%枚", "&7投入 %{_in}%枚 / 払い出し %{_out}%枚" and "&7機械割: &f%{_wari}%%%"
    set slot 50 of {_g} to {_sd}
    # ゾーン中は、リールのまわりの色が変わる
    set {_fr} to cs_pane()
    if {_m} is "n":
        if {casino::st::%{_sk}%::zone} is "cyber":
            set {_fr} to cs_it(light blue stained glass pane, "", "&b覚醒ゾーン")
        else if {casino::st::%{_sk}%::zone} is "bar":
            set {_fr} to cs_it(orange stained glass pane, "", "&6BARドライブ")
        else if {casino::st::%{_sk}%::pbg} > 0:
            set {_fr} to cs_it(lime stained glass pane, "", "&a引き戻し区間")
    loop 1, 2, 6, 7, 19, 20, 24 and 25:
        set slot loop-value of {_g} to {_fr}

function cs_draw(p: player):
    if tb_on({_p}) is true:
        tb_draw({_p})
        stop
    if ph_on({_p}) is true:
        ph_draw({_p})
        stop
    if hs_on({_p}) is true:
        hs_draw({_p})
        stop
    if wm_on({_p}) is true:
        wm_draw({_p})
        stop
    if do_on({_p}) is true:
        do_draw({_p})
        stop
    if hd_on({_p}) is true:
        hd_draw({_p})
        stop
    set {_g} to cs_slotgui({_p})
    # リール (台の表示も)
    cs_reel({_p}, 1)
    cs_reel({_p}, 2)
    cs_reel({_p}, 3)
    if {_g} is set:
        cs_btns({_p})
    # 結果発表までは、状態の表示 (ランプ・ボスバー・台の文字) を変えない
    if {-cs::hold::%uuid of {_p}%} is true:
        stop
    if {_g} is set:
        cs_lamps({_p}, cs_lampkind({_p}))
        cs_info({_p})
    else:
        cs_mlamps({_p}, cs_lampkind({_p}))
    cs_bar({_p})
    if {-cs::useat::%uuid of {_p}%} is set:
        cs_mtext({-cs::useat::%uuid of {_p}%})

function cs_openslot(p: player):
    if tb_on({_p}) is true:
        tb_open({_p})
        stop
    if ph_on({_p}) is true:
        ph_openslot({_p})
        stop
    if hs_on({_p}) is true:
        hs_openslot({_p})
        stop
    if wm_on({_p}) is true:
        wm_openslot({_p})
        stop
    if do_on({_p}) is true:
        do_openslot({_p})
        stop
    if hd_on({_p}) is true:
        hd_openslot({_p})
        stop
    cs_init({_p})
    set {_u} to uuid of {_p}
    set {_g} to a new chest inventory with 6 rows named "&5&lNoName スロット"
    set {_pn} to cs_pane()
    loop 54 times:
        set slot ((loop-number) - 1) of {_g} to {_pn}
    set {_ln} to cs_it(yellow stained glass pane, "", "&e&l▶ 5ライン ◀")
    set lore of {_ln} to "&7上段・中段・下段・右下がり・右上がり" and "&7どれかのラインでそろえば当たり"
    set slot 11 of {_g} to {_ln}
    set slot 15 of {_g} to {_ln}
    set {_bk} to cs_it(arrow, "", "&7← カジノへ戻る")
    set slot 46 of {_g} to {_bk}
    set {_hw} to cs_it(book, "", "&f遊び方")
    set lore of {_hw} to "&e1. &fBET (×1〜×10・アイテムで ×100 以上も) を決めて レバー → STOP 1〜3", "&e2. &f5ライン (上・中・下・斜め2本) で役がそろうとメダル", "&8―――――――――――", "&f通常時: 1Gごと・レア役で &bポイント", "&7ポイントが周期の規定 (100〜600pt) に届くと &c覚醒チャレンジ &7の抽選", "&7(モードで当たりやすさが違う・6周期目は確定)", "&bレア役 &7→ &b覚醒ゾーン &7(ポイント大量) / &fBAR揃い &7→ &6BARドライブ &7(チャレンジ高確率)", "&c覚醒チャレンジ &7(11G) 成功 → &e覚醒ボーナス &7か &c決戦ボーナス", "&7ボーナス中の抽選に勝つと &d&lNoName ラッシュ &7(純増 約9枚)", "&7セットの終わりに &c覚醒ジャッジ&7。Vストックがあれば成功", "&73回成功で &6&l超 NoName ラッシュ &7(継続 約90%%)", "&7終わったあと 66G は &a引き戻し &7のチャンス", "&d&lNoName7 揃い &7・&5フリーズ &7・1500G 天井あり" and "&7途中で閉じても、状態はそのまま残る"
    set slot 48 of {_g} to {_hw}
    open {_g} to {_p}
    set {-cs::gui::%{_u}%} to {_g}
    set {-cs::type::%{_u}%} to "slot"
    cs_draw({_p})
    cs_bgmsync({_p})

# ============================================================
#  BGM・ボスバー
# ============================================================

function cs_bgmstop(p: player):
    set {_u} to uuid of {_p}
    add 1 to {-cs::btok::%{_u}%}
    delete {-cs::bgmnow::%{_u}%}
    if {_p} is online:
        stop sound "skown:slot.at_bgm" and "skown:slot.batt_bgm" for {_p}
        stop sound "skown:hades.bgm_chance", "skown:hades.bgm_rush" and "skown:hades.bgm_mode" for {_p}
        stop sound "skown:doa.bgm_dead", "skown:doa.bgm_alive", "skown:doa.bgm_judge", "skown:doa.bgm_heaven", "skown:doa.bgm_exec" and "skown:doa.bgm_god" for {_p}
        stop sound "skown:wm.bgm_challenge", "skown:wm.bgm_bounty", "skown:wm.bgm_hunt", "skown:wm.bgm_hero", "skown:wm.bgm_missed" and "skown:wm.bgm_murdered" for {_p}
        stop sound "skown:wm.bgm_yaw", "skown:wm.bgm_wanted", "skown:wm.bgm_superwanted", "skown:wm.bgm_assassin" and "skown:wm.bgm_god" for {_p}
        stop sound "skown:hs.bgm_chance", "skown:hs.bgm_bank", "skown:hs.bgm_chase", "skown:hs.bgm_wait", "skown:hs.bgm_armed" and "skown:hs.bgm_target" for {_p}
        stop sound "skown:hs.bgm_plan", "skown:hs.bgm_raid", "skown:hs.bgm_xhq", "skown:hs.bgm_fate", "skown:hs.bgm_lone" and "skown:hs.bgm_stable" for {_p}
        stop sound "skown:hs.bgm_friendly", "skown:hs.bgm_superlone", "skown:hs.bgm_superstable" and "skown:hs.bgm_superfriendly" for {_p}
        stop sound "skown:ph.bgm_spin", "skown:ph.bgm_super", "skown:ph.bgm_challenge" and "skown:ph.bgm_nolimit" for {_p}
        stop sound "skown:tb.bgm_lounge" and "skown:tb.bgm_fever" for {_p}

function cs_bgm(p: player, name: text):
    cs_bgmstop({_p})
    set {_u} to uuid of {_p}
    set {-cs::bgmnow::%{_u}%} to {_name}
    set {_tok} to {-cs::btok::%{_u}%}
    set {_len} to 512
    set {_key} to "skown:slot.%{_name}%"
    if {_name} is "batt_bgm":
        set {_len} to 274
    if {_name} starts with "hades.":
        set {_key} to "skown:%{_name}%"
    if {_name} starts with "doa.":
        set {_key} to "skown:%{_name}%"
    if {_name} starts with "wm.":
        set {_key} to "skown:%{_name}%"
    if {_name} starts with "hs.":
        set {_key} to "skown:%{_name}%"
    if {_name} starts with "ph.":
        set {_key} to "skown:%{_name}%"
    if {_name} starts with "tb.":
        set {_key} to "skown:%{_name}%"
    if {_name} is "hades.bgm_chance" or "doa.bgm_exec" or "wm.bgm_challenge" or "wm.bgm_hunt" or "wm.bgm_yaw" or "hs.bgm_chance" or "hs.bgm_bank" or "hs.bgm_target" or "hs.bgm_fate":
        set {_len} to 256
    loop 2000 times:
        if {_p} is not online:
            stop
        if {-cs::btok::%{_u}%} is not {_tok}:
            stop
        if cs_playing({_p}) is false:
            delete {-cs::bgmnow::%{_u}%}
            stop
        play sound {_key} with volume 0.55 and pitch 1 to {_p}
        wait cs_ticks({_len})

# 今の状態に合った BGM にする (流れていなければ流す)
function cs_bgmsync(p: player):
    if tb_on({_p}) is true:
        tb_bgm({_p})
        stop
    if ph_on({_p}) is true:
        ph_bgmsync({_p})
        stop
    if hs_on({_p}) is true:
        hs_bgmsync({_p})
        stop
    if wm_on({_p}) is true:
        wm_bgmsync({_p})
        stop
    if do_on({_p}) is true:
        do_bgmsync({_p})
        stop
    if hd_on({_p}) is true:
        hd_bgmsync({_p})
        stop
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    if {-cs::hold::%{_u}%} is true:
        stop
    if cs_playing({_p}) is false:
        stop
    set {_m} to {casino::st::%{_sk}%::mode}
    set {_want} to ""
    if {_m} is "at" or "bb":
        set {_want} to "at_bgm"
    else if {_m} is "cz" or "rb" or "jg":
        set {_want} to "batt_bgm"
    if {_want} is "":
        if {-cs::bgmnow::%{_u}%} is set:
            cs_bgmstop({_p})
        stop
    if {-cs::bgmnow::%{_u}%} is {_want}:
        stop
    cs_bgm({_p}, {_want})

function cs_barremove(p: player):
    set {_u} to uuid of {_p}
    if {-cs::bar::%{_u}%} is set:
        if {_p} is online:
            remove {_p} from viewers of {-cs::bar::%{_u}%}
        delete {-cs::bar::%{_u}%}
        delete {-cs::barm::%{_u}%}

function cs_bar(p: player):
    if tb_on({_p}) is true:
        tb_bar({_p})
        stop
    if ph_on({_p}) is true:
        ph_bar({_p})
        stop
    if hs_on({_p}) is true:
        hs_bar({_p})
        stop
    if wm_on({_p}) is true:
        wm_bar({_p})
        stop
    if do_on({_p}) is true:
        do_bar({_p})
        stop
    if hd_on({_p}) is true:
        hd_bar({_p})
        stop
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    if {_p} is not online:
        stop
    if {-cs::hold::%{_u}%} is true:
        stop
    if cs_playing({_p}) is false:
        cs_barremove({_p})
        stop
    set {_m} to {casino::st::%{_sk}%::mode}
    set {_key} to {_m}
    if {_m} is "at":
        if {casino::st::%{_sk}%::sup} is true:
            set {_key} to "sup"
    if {-cs::bar::%{_u}%} is set:
        if {-cs::barm::%{_u}%} is not {_key}:
            cs_barremove({_p})
    if {-cs::bar::%{_u}%} is not set:
        if {_key} is "cz" or "rb" or "jg":
            set {-cs::bar::%{_u}%} to a red boss bar titled "&c&l…"
        else if {_key} is "bb" or "sup":
            set {-cs::bar::%{_u}%} to a yellow boss bar titled "&e&l…"
        else if {_key} is "at":
            set {-cs::bar::%{_u}%} to a pink boss bar titled "&d&l…"
        else:
            set {-cs::bar::%{_u}%} to a purple boss bar titled "&5&l…"
        set {-cs::barm::%{_u}%} to {_key}
        add {_p} to viewers of {-cs::bar::%{_u}%}
    set {_st::*} to cs_status({_p})
    set title of {-cs::bar::%{_u}%} to "&e×%cs_mult({_p})% %{_st::1}% &7| %{_st::2}% &7| %{_st::3}%"
    set {_pr} to 0
    if {_m} is "n":
        set {_pr} to {casino::st::%{_sk}%::pt} / {casino::st::%{_sk}%::tgt}
    else if {_m} is "cz":
        set {_pr} to {casino::st::%{_sk}%::czg} / 11
    else if {_m} is "bb":
        set {_pr} to {casino::st::%{_sk}%::bbg} / 45
    else if {_m} is "rb":
        set {_pr} to {casino::st::%{_sk}%::rbg} / 9
    else if {_m} is "jg":
        set {_pr} to {casino::st::%{_sk}%::jg} / 3
    else:
        set {_pr} to {casino::st::%{_sk}%::atl} / 30
    if {_pr} > 1:
        set {_pr} to 1
    if {_pr} < 0:
        set {_pr} to 0
    set progress of {-cs::bar::%{_u}%} to {_pr}

# ============================================================
#  1ゲーム
#  レバーを引いた瞬間に 小役・状態の変化をぜんぶ決めて保存 (pr / ppay / pev)
#  リールが止まったら メダルを払い出して演出 (結果発表までは表示を hold で止めておく)
# ============================================================

function cs_lever(p: player):
    if tb_on({_p}) is true:
        tb_lever({_p})
        stop
    if ph_on({_p}) is true:
        ph_lever({_p})
        stop
    if hs_on({_p}) is true:
        hs_lever({_p})
        stop
    if wm_on({_p}) is true:
        wm_lever({_p})
        stop
    if do_on({_p}) is true:
        do_lever({_p})
        stop
    if hd_on({_p}) is true:
        hd_lever({_p})
        stop
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    if {-cs::spin::%{_u}%} is true:
        stop
    if {-cs::busy::%{_u}%} is true:
        stop
    if {-cs::anywhere} is not true:
        if {-cs::useat::%{_u}%} is not set:
            close {_p}'s inventory
            send action bar "&7スロット台を右クリックして遊んでね" to {_p}
            stop
    cs_init({_p})
    if {casino::st::%{_sk}%::pr} is set:
        # 前のゲームの結果が残っている (ふつうは無い)
        cs_resolve({_p})
        stop
    set {_mu} to cs_mult({_p})
    set {_cost} to {@bet} * {_mu}
    if cs_med({_p}) < {_cost}:
        cs_bar_msg({_p}, "&cメダルが足りません &7(BET ×%{_mu}% = 1回 %{_cost}%枚・両替所で手に入る)")
        play sound "block.note_block.bass" with volume 0.6 and pitch 0.6 to {_p}
        if {-cs::auto::%{_u}%} is true:
            delete {-cs::auto::%{_u}%}
            cs_btns({_p})
        stop
    set {-cs::lastact::%{_u}%} to now
    cs_addmed({_p}, 0 - {_cost})
    add {_cost} to {casino::stat::%{_u}%::in}
    add 1 to {casino::stat::%{_u}%::games}
    set {_m} to {casino::st::%{_sk}%::mode}
    if {_m} is "n":
        set {_role} to cs_role()
        if (random number between 0 and 8192) < 1:
            set {_role} to "freeze"
    else if {_m} is "cz":
        set {_role} to cs_role()
    else:
        set {_role} to cs_atrole()
    set {_pay} to cs_pay({_role}, {_m}) * {_mu}
    set {_ev::*} to cs_step({_p}, {_role}, {_mu})
    # 結果は先に保存 (落ちても次に入ったときに払い出す)
    set {casino::st::%{_sk}%::pr} to {_role}
    set {casino::st::%{_sk}%::ppay} to {_pay}
    set {casino::st::%{_sk}%::powner} to "%{_u}%"
    set {casino::st::%{_sk}%::pev} to join {_ev::*} with ","
    # (OP の /casino skip 中) 演出なしで すぐ払い出して終わる
    if {-cs::skip::%{_u}%} is true:
        loop split "pr,ppay,pev,phi,powner" at ",":
            delete {casino::st::%{_sk}%::%loop-value%}
        if {_pay} > 0:
            cs_addmed({_p}, {_pay})
            add {_pay} to {casino::stat::%{_u}%::out}
        set {-cs::skipev::%{_u}%::*} to {_ev::*}
        set {-cs::skiprole::%{_u}%} to {_role}
        set {-cs::skippay::%{_u}%} to {_pay}
        stop
    set {_hi} to cs_flashy({_role})
    # 決着のゲーム (チャレンジ・ボーナス・ジャッジの最後) は、勝ち負けが音でわからないように小役だけで決める
    set {_fin} to false
    loop {_ev::*}:
        if loop-value is "czwin" or "czlose" or "bbwin" or "bblose" or "rbwin" or "rblose" or "jgwin" or "jglose":
            set {_fin} to true
    if {_fin} is false:
        loop {_ev::*}:
            if loop-value is "czstart" or "bbstart" or "rbstart" or "atstart" or "drive" or "kenin" or "zonein" or "barin" or "nn7at" or "super":
                set {_hi} to true
    set {casino::st::%{_sk}%::phi} to {_hi}
    # ゾーン・チャレンジ・ボーナス・ラッシュに入ったら、オートプレイは止める
    if {-cs::auto::%{_u}%} is true:
        loop {_ev::*}:
            if loop-value is "zonein" or "barin" or "czstart" or "bbstart" or "rbstart" or "atstart":
                delete {-cs::auto::%{_u}%}
                set {-cs::autooff::%{_u}%} to true
    set {-cs::hold::%{_u}%} to true
    loop 3 times:
        set {_sp} to {-cs::pos::%{_u}%::%loop-number%}
        if {_sp} is not set:
            set {_sp} to random integer between 1 and 21
        set {-cs::sp::%{_u}%::%loop-number%} to {_sp}
    cs_setline({_p}, {_role})
    set {-cs::spin::%{_u}%} to true
    delete {-cs::rs::%{_u}%::*}
    add 1 to {-cs::tok::%{_u}%}
    set {_tok} to {-cs::tok::%{_u}%}
    cs_snd({_p}, "bet", 0.8, 1)
    cs_snd({_p}, "lever", 0.9, 1)
    cs_draw({_p})
    cs_leverfx({_p}, {_m}, {_role}, {_ev::*})
    cs_spin({_p}, {_tok})
    cs_mfx({_p}, "lever")
    cs_mlever({_p})

# レバーを引いたときの予告 (キュイン・ランプ)
function cs_leverfx(p: player, m: text, role: text, ev: texts):
    set {_u} to uuid of {_p}
    set {_big} to false
    set {_mid} to false
    set {_fin} to false
    loop {_ev::*}:
        if loop-value is "czwin" or "czlose" or "bbwin" or "bblose" or "rbwin" or "rblose" or "jgwin" or "jglose":
            set {_fin} to true
    if {_fin} is false:
        loop {_ev::*}:
            if loop-value is "drive" or "nn7at" or "nn7bb" or "super":
                set {_big} to true
            if loop-value is "czstart" or "bbstart" or "rbstart" or "atstart" or "kenin" or "zonein" or "barin" or "uwa" or "czup" or "bbup" or "vstock":
                set {_mid} to true
    if {_role} is "freeze":
        set {-cs::frz::%{_u}%} to true
        add 1 to {-cs::ftok::%{_u}%}
        cs_lamps({_p}, "off")
        cs_bgmstop({_p})
        cs_snd({_p}, "freeze", 1, 1)
        cs_mfx({_p}, "freeze")
        cs_title({_p}, "&0.", "&r", 50)
        wait cs_wt({_p}, 52)
        delete {-cs::frz::%{_u}%}
        cs_snd({_p}, "kyuin_rainbow", 1, 1)
        cs_mfx({_p}, "rainbow")
        cs_title({_p}, "&5&l⚡ ロングフリーズ ⚡", "&d何かが起きた…", 40)
        cs_flash({_p}, "rainbow", "off", 16, 3)
        stop
    if {_role} is "nn7" or "red7":
        set {_big} to true
    if {_big} is true:
        cs_snd({_p}, "kyuin_rainbow", 1, 1)
        cs_mfx({_p}, "rainbow")
        cs_flash({_p}, "rainbow", "gold", 14, 3)
        stop
    if {_mid} is true:
        if chance of 65%:
            cs_snd({_p}, "kyuin", 1, 1)
            cs_mfx({_p}, "kyuin")
            cs_flash({_p}, "red", "gold", 10, 3)
        else:
            cs_snd({_p}, "yokoku", 1, 1)
            cs_mfx({_p}, "yokoku")
            cs_flash({_p}, "red", "purple", 6, 3)
        stop
    if cs_flashy({_role}) is true:
        if chance of 40%:
            cs_snd({_p}, "yokoku", 1, 1)
            cs_mfx({_p}, "yokoku")
            cs_flash({_p}, "red", "purple", 6, 3)
        stop
    # ガセ
    if chance of 2%:
        cs_snd({_p}, "yokoku", 1, 1)
        cs_mfx({_p}, "yokoku")
        cs_flash({_p}, "red", "purple", 4, 3)

# 回っている間の見張り (オートなら自動で止める・放っておいても止まる)
function cs_spin(p: player, tok: number):
    set {_u} to uuid of {_p}
    set {_t} to 0
    set {_auto} to 0
    loop 200 times:
        wait 2 ticks
        if {-cs::tok::%{_u}%} is not {_tok}:
            stop
        if {-cs::spin::%{_u}%} is not true:
            stop
        add 2 to {_t}
        if {_p} is not online:
            cs_stopall({_p})
            stop
        if cs_playing({_p}) is false:
            cs_stopall({_p})
            stop
        if {-cs::frz::%{_u}%} is not true:
            # 台の図柄を1コマ流す
            if {-cs::useat::%{_u}%} is set:
                loop 3 times:
                    if {-cs::rs::%{_u}%::%loop-number-2%} is not true:
                        set {_sp} to {-cs::sp::%{_u}%::%loop-number-2%} - 1
                        if {_sp} < 1:
                            set {_sp} to 21
                        set {-cs::sp::%{_u}%::%loop-number-2%} to {_sp}
                        cs_mreel({_p}, loop-number-2)
            set {_as} to false
            if {-cs::auto::%{_u}%} is true:
                set {_as} to true
            if cs_fast({_p}) is true:
                set {_as} to true
            if {_as} is true:
                add 2 to {_auto}
                set {_first} to 12
                set {_next} to 6
                if cs_fast({_p}) is true:
                    set {_first} to 4
                    set {_next} to 2
                    if cs_fastlv({_p}) >= 2:
                        set {_first} to 2
                    if cs_fastlv({_p}) >= 3:
                        cs_stopall({_p})
                        stop
                if {_auto} >= {_first}:
                    set {_auto} to {_first} - {_next}
                    loop 3 times:
                        if {-cs::rs::%{_u}%::%loop-number-2%} is not true:
                            cs_stopreel({_p}, loop-number-2)
                            exit loop
            if {_t} >= 300:
                cs_stopall({_p})
                stop
    cs_stopall({_p})

function cs_stopall(p: player):
    if tb_on({_p}) is true:
        add 0 to {_none}
        stop
    if ph_on({_p}) is true:
        add 0 to {_none}
        stop
    if hs_on({_p}) is true:
        hs_stopall({_p})
        stop
    if wm_on({_p}) is true:
        wm_stopall({_p})
        stop
    if do_on({_p}) is true:
        do_stopall({_p})
        stop
    if hd_on({_p}) is true:
        hd_stopall({_p})
        stop
    set {_u} to uuid of {_p}
    loop 3 times:
        if {-cs::spin::%{_u}%} is true:
            cs_stopreel({_p}, loop-number)

function cs_stopreel(p: player, r: number):
    if tb_on({_p}) is true:
        tb_button({_p}, {_r})
        stop
    if ph_on({_p}) is true:
        ph_button({_p}, {_r})
        stop
    if hs_on({_p}) is true:
        hs_stopreel({_p}, {_r})
        stop
    if wm_on({_p}) is true:
        wm_stopreel({_p}, {_r})
        stop
    if do_on({_p}) is true:
        do_stopreel({_p}, {_r})
        stop
    if hd_on({_p}) is true:
        hd_stopreel({_p}, {_r})
        stop
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    if {-cs::spin::%{_u}%} is not true:
        stop
    if {-cs::rs::%{_u}%::%{_r}%} is true:
        stop
    set {-cs::rs::%{_u}%::%{_r}%} to true
    cs_mbtn({_p}, {_r})
    set {_n} to 0
    loop 3 times:
        if {-cs::rs::%{_u}%::%loop-number%} is true:
            add 1 to {_n}
    cs_reel({_p}, {_r})
    set {_role} to {casino::st::%{_sk}%::pr}
    if {_n} < 3:
        cs_snd({_p}, "stop", 1, 1)
        cs_btns({_p})
        if {_n} is 2:
            if {_role} is "nn7" or "freeze" or "red7":
                cs_snd({_p}, "reach", 1, 1)
        stop
    if {casino::st::%{_sk}%::phi} is true:
        cs_snd({_p}, "stop_hi", 1, 1)
    else:
        cs_snd({_p}, "stop", 1, 1)
    set {-cs::spin::%{_u}%} to false
    cs_resolve({_p})

# リールが全部止まった → メダルを払い出して演出
function cs_resolve(p: player):
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    set {_role} to {casino::st::%{_sk}%::pr}
    if {_role} is not set:
        stop
    set {_pay} to {casino::st::%{_sk}%::ppay}
    if {_pay} is not set:
        set {_pay} to 0
    # 落ちる前に別の人が回していたゲームなら、その人に払い出すだけ
    set {_ow} to {casino::st::%{_sk}%::powner}
    if {_ow} is set:
        if {_ow} is not "%{_u}%":
            loop split "pr,ppay,pev,phi,powner" at ",":
                delete {casino::st::%{_sk}%::%loop-value%}
            if {_pay} > 0:
                if {casino::medal::%{_ow}%} is not set:
                    set {casino::medal::%{_ow}%} to 0
                add {_pay} to {casino::medal::%{_ow}%}
            delete {-cs::hold::%{_u}%}
            cs_draw({_p})
            stop
    set {_evt} to {casino::st::%{_sk}%::pev}
    if {_evt} is not set:
        set {_evt} to "-"
    set {_ev::*} to split {_evt} at ","
    delete {casino::st::%{_sk}%::pr}
    delete {casino::st::%{_sk}%::ppay}
    delete {casino::st::%{_sk}%::pev}
    delete {casino::st::%{_sk}%::phi}
    delete {casino::st::%{_sk}%::powner}
    if {_pay} > 0:
        cs_addmed({_p}, {_pay})
        add {_pay} to {casino::stat::%{_u}%::out}
    cs_draw({_p})
    cs_fx({_p}, {_role}, {_pay}, {_ev::*})

# ============================================================
#  状態の変化 (sim2.py と同じルール)
# ============================================================

function cs_czgo(p: player):
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    set {casino::st::%{_sk}%::mode} to "cz"
    set {casino::st::%{_sk}%::czg} to 11
    set {casino::st::%{_sk}%::sv} to cs_setting({_p})
    set {casino::st::%{_sk}%::czw} to cs_tbl("czbase", {casino::st::%{_sk}%::sv})
    set {casino::st::%{_sk}%::czk} to false
    set {casino::st::%{_sk}%::zone} to ""
    add 1 to {casino::stat::%{_u}%::cz}

function cs_bonus(p: player, kind: text, sure: boolean):
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    set {_sv} to cs_setv({_p})
    set {casino::st::%{_sk}%::sv} to {_sv}
    set {casino::st::%{_sk}%::zone} to ""
    set {casino::st::%{_sk}%::since} to 0
    set {casino::st::%{_sk}%::pbg} to 0
    if {_kind} is "bb":
        set {casino::st::%{_sk}%::mode} to "bb"
        set {casino::st::%{_sk}%::bbg} to 45
        set {casino::st::%{_sk}%::bbw} to cs_tbl("bbat", {_sv})
        set {casino::st::%{_sk}%::bbk} to {_sure}
        add 1 to {casino::stat::%{_u}%::bb}
    else:
        set {casino::st::%{_sk}%::mode} to "rb"
        set {casino::st::%{_sk}%::rbg} to 9
        set {casino::st::%{_sk}%::rbw} to false
        set {_c} to cs_tbl("rbat", {_sv})
        if chance of {_c}%:
            set {casino::st::%{_sk}%::rbw} to true
        set {casino::st::%{_sk}%::rbm} to random integer between 1 and 3
        add 1 to {casino::stat::%{_u}%::rb}

# ラッシュを始める。keep = セット継続 (獲得枚数などを引き継ぐ)
function cs_atgo(p: player, sup: boolean, len: number, vs: number, keep: boolean):
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    if {_keep} is false:
        set {casino::st::%{_sk}%::sv} to cs_setv({_p})
    set {casino::st::%{_sk}%::mode} to "at"
    set {casino::st::%{_sk}%::zone} to ""
    set {casino::st::%{_sk}%::since} to 0
    set {casino::st::%{_sk}%::pbg} to 0
    if {_keep} is false:
        set {casino::st::%{_sk}%::gain} to 0
        set {casino::st::%{_sk}%::sets} to 0
        set {casino::st::%{_sk}%::vl} to 0
        set {casino::st::%{_sk}%::sup} to {_sup}
        add 1 to {casino::stat::%{_u}%::at}
    if {_len} > 0:
        set {casino::st::%{_sk}%::atl} to {_len}
    else:
        set {casino::st::%{_sk}%::atl} to cs_setlen()
    add {_vs} to {casino::st::%{_sk}%::vs}
    add 1 to {casino::st::%{_sk}%::sets}
    set {casino::st::%{_sk}%::ken} to 0

# 通常時へ。pullback = 引き戻し区間 66G をつける
function cs_tonormal(p: player, pullback: boolean, sup: boolean):
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    set {casino::st::%{_sk}%::mode} to "n"
    set {_sv} to cs_setv({_p})
    set {casino::st::%{_sk}%::md} to cs_newmode({_sv})
    set {casino::st::%{_sk}%::cyc} to 1
    set {casino::st::%{_sk}%::pt} to 0
    set {casino::st::%{_sk}%::tgt} to cs_cyc()
    set {casino::st::%{_sk}%::zone} to ""
    set {casino::st::%{_sk}%::pbg} to 0
    set {casino::st::%{_sk}%::pbat} to -1
    if {_pullback} is true:
        set {casino::st::%{_sk}%::pbg} to 66
        set {casino::st::%{_sk}%::pbsup} to {_sup}
        set {_pc} to cs_tbl("pb", {_sv})
        if chance of {_pc}%:
            set {casino::st::%{_sk}%::pbat} to random integer between 1 and 66

function cs_atend(p: player):
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    set {_g} to {casino::st::%{_sk}%::gain}
    set {-cs::last::%{_u}%::gain} to {_g}
    set {-cs::last::%{_u}%::set} to {casino::st::%{_sk}%::sets}
    set {-cs::last::%{_u}%::name} to name of {_p}
    if {_g} > {casino::stat::%{_u}%::best}:
        set {casino::stat::%{_u}%::best} to {_g}
    delete {-cs::last::%{_u}%::rec}
    if {casino::rec::best} is not set:
        set {casino::rec::best} to 0
    if {_g} > {casino::rec::best}:
        set {casino::rec::best} to {_g}
        set {casino::rec::name} to name of {_p}
        set {-cs::last::%{_u}%::rec} to true
    set {casino::st::%{_sk}%::vs} to 0
    # 大きく出たらトロフィー (BET ×1 で 5000枚 = 倍率に合わせて増える。演出のあとに渡す。いなければ次に入ったとき)
    set {_mu} to cs_mult({_p})
    if {_g} >= ({@trophy} * {_mu}):
        add "%{_g}%|%{casino::st::%{_sk}%::sets}%|%{_mu}%" to {casino::trophyq::%{_u}%::*}
    cs_tonormal({_p}, true, {casino::st::%{_sk}%::sup})

# 1ゲームぶん状態を進める。起きたことを返す (先頭は "-")
function cs_step(p: player, role: text, mu: number) :: texts:
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    set {_ev::*} to "-"
    set {_m} to {casino::st::%{_sk}%::mode}
    set {_rare} to cs_rare({_role})
    # ---------- 通常時 ----------
    if {_m} is "n":
        if {_role} is "freeze":
            cs_atgo({_p}, true, 20, 9, false)
            add 1 to {casino::stat::%{_u}%::freeze}
            add 1 to {casino::stat::%{_u}%::sup}
            if {_p} is online:
                broadcast "{@prefix} &5&l⚡ ロングフリーズ! &e%name of {_p}% &fの NoName スロットで ロングフリーズが発生!"
            add "freeze" and "atstart" to {_ev::*}
            return {_ev::*}
        add 1 to {casino::st::%{_sk}%::since}
        # 引き戻し区間
        if {casino::st::%{_sk}%::pbg} > 0:
            remove 1 from {casino::st::%{_sk}%::pbg}
            if 66 - {casino::st::%{_sk}%::pbg} is {casino::st::%{_sk}%::pbat}:
                cs_atgo({_p}, {casino::st::%{_sk}%::pbsup}, 0, 0, false)
                if {casino::st::%{_sk}%::sup} is true:
                    add 1 to {casino::stat::%{_u}%::sup}
                add "pbwin" and "atstart" to {_ev::*}
                return {_ev::*}
            if {casino::st::%{_sk}%::pbg} is 0:
                add "pbend" to {_ev::*}
        if {_role} is "nn7":
            cs_bonus({_p}, "bb", true)
            add "nn7bb" and "bbstart" to {_ev::*}
            return {_ev::*}
        if {casino::st::%{_sk}%::since} >= 1500:
            cs_bonus({_p}, "bb", false)
            add "tenjo" and "bbstart" to {_ev::*}
            return {_ev::*}
        set {_add} to 1
        if {_rare} is true:
            add cs_ptrare({_role}) to {_add}
        set {_z} to {casino::st::%{_sk}%::zone}
        if {_z} is "cyber":
            add 8 to {_add}
            if {_rare} is true:
                add 30 to {_add}
            remove 1 from {casino::st::%{_sk}%::zg}
            if {casino::st::%{_sk}%::zg} <= 0:
                if chance of 35%:
                    add 1 to {casino::st::%{_sk}%::zs}
                    set {casino::st::%{_sk}%::zg} to 5
                    if {casino::st::%{_sk}%::zs} >= 10:
                        set {casino::st::%{_sk}%::zone} to ""
                        cs_bonus({_p}, "bb", false)
                        add "zonebb" and "bbstart" to {_ev::*}
                        return {_ev::*}
                    add "zonenext" to {_ev::*}
                else:
                    set {casino::st::%{_sk}%::zone} to ""
                    add "zoneend" to {_ev::*}
        else if {_z} is "bar":
            remove 1 from {casino::st::%{_sk}%::zg}
            set {_hit} to false
            if chance of 6.4%:
                set {_hit} to true
            if {_role} is "scherry" or "chance":
                set {_hit} to true
            if {_hit} is true:
                set {casino::st::%{_sk}%::zone} to ""
                cs_czgo({_p})
                add "barcz" and "czstart" to {_ev::*}
                return {_ev::*}
            if {casino::st::%{_sk}%::zg} <= 0:
                set {casino::st::%{_sk}%::zone} to ""
                add "barend" to {_ev::*}
        else:
            if {_role} is "bar":
                set {casino::st::%{_sk}%::zone} to "bar"
                set {casino::st::%{_sk}%::zg} to 8
                add "barin" to {_ev::*}
            else if {_rare} is true:
                set {_c} to cs_zonein({_role})
                if chance of {_c}%:
                    set {casino::st::%{_sk}%::zone} to "cyber"
                    set {casino::st::%{_sk}%::zg} to 5
                    set {casino::st::%{_sk}%::zs} to 1
                    add "zonein" to {_ev::*}
        add {_add} to {casino::st::%{_sk}%::pt}
        if {casino::st::%{_sk}%::pt} >= {casino::st::%{_sk}%::tgt}:
            if {casino::st::%{_sk}%::zone} is "":
                remove {casino::st::%{_sk}%::tgt} from {casino::st::%{_sk}%::pt}
                set {_go} to false
                set {_c} to cs_modecz({casino::st::%{_sk}%::md})
                if {casino::st::%{_sk}%::cyc} >= 6:
                    set {_go} to true
                else if chance of {_c}%:
                    set {_go} to true
                if {_go} is true:
                    set {-cs::cyc::%{_u}%} to {casino::st::%{_sk}%::cyc}
                    cs_czgo({_p})
                    add "cyclecz" and "czstart" to {_ev::*}
                    return {_ev::*}
                add 1 to {casino::st::%{_sk}%::cyc}
                set {casino::st::%{_sk}%::tgt} to cs_cyc()
                add "cycle" to {_ev::*}
        return {_ev::*}
    # ---------- 覚醒チャレンジ (CZ) ----------
    if {_m} is "cz":
        if {_role} is "nn7":
            set {casino::st::%{_sk}%::czk} to true
            add "czup" to {_ev::*}
        else if {_rare} is true:
            add 10 to {casino::st::%{_sk}%::czw}
            add "czup" to {_ev::*}
        else if {_role} is "bar":
            add 10 to {casino::st::%{_sk}%::czw}
            add "czup" to {_ev::*}
        remove 1 from {casino::st::%{_sk}%::czg}
        if {casino::st::%{_sk}%::czg} <= 0:
            set {_win} to false
            if {casino::st::%{_sk}%::czk} is true:
                set {_win} to true
            else if chance of {casino::st::%{_sk}%::czw}%:
                set {_win} to true
            if {_win} is true:
                if chance of 55%:
                    cs_bonus({_p}, "bb", false)
                    add "czwin" and "bbstart" to {_ev::*}
                else:
                    cs_bonus({_p}, "rb", false)
                    add "czwin" and "rbstart" to {_ev::*}
            else:
                cs_tonormal({_p}, false, false)
                add "czlose" to {_ev::*}
        return {_ev::*}
    # ---------- 覚醒ボーナス ----------
    if {_m} is "bb":
        set {_up} to {_rare}
        if {_role} is "bar" or "red7":
            set {_up} to true
        if {_up} is true:
            add 8 to {casino::st::%{_sk}%::bbw}
            add "bbup" to {_ev::*}
        if {_role} is "nn7":
            set {casino::st::%{_sk}%::bbk} to true
            add "bbup" to {_ev::*}
        remove 1 from {casino::st::%{_sk}%::bbg}
        if {casino::st::%{_sk}%::bbg} <= 0:
            set {_win} to false
            if {casino::st::%{_sk}%::bbk} is true:
                set {_win} to true
            else if chance of {casino::st::%{_sk}%::bbw}%:
                set {_win} to true
            if {_win} is true:
                cs_atgo({_p}, false, 0, 0, false)
                add "bbwin" and "atstart" to {_ev::*}
            else:
                cs_tonormal({_p}, true, false)
                add "bblose" to {_ev::*}
        return {_ev::*}
    # ---------- 決戦ボーナス (3G ごとにミッション) ----------
    if {_m} is "rb":
        if {_role} is "nn7":
            set {casino::st::%{_sk}%::rbw} to true
        remove 1 from {casino::st::%{_sk}%::rbg}
        set {_done} to 9 - {casino::st::%{_sk}%::rbg}
        if mod({_done}, 3) is 0:
            set {_mi} to {_done} / 3
            set {-cs::mis::%{_u}%} to {_mi}
            if {casino::st::%{_sk}%::rbw} is true:
                add "misok" to {_ev::*}
            else if {_mi} < {casino::st::%{_sk}%::rbm}:
                add "misok" to {_ev::*}
            else if {_mi} is {casino::st::%{_sk}%::rbm}:
                if {casino::st::%{_sk}%::rbg} > 0:
                    add "misng" to {_ev::*}
        if {casino::st::%{_sk}%::rbg} <= 0:
            if {casino::st::%{_sk}%::rbw} is true:
                cs_atgo({_p}, false, 0, 0, false)
                add "rbwin" and "atstart" to {_ev::*}
            else:
                cs_tonormal({_p}, true, false)
                add "rblose" to {_ev::*}
        return {_ev::*}
    # ---------- NoName ラッシュ ----------
    if {_m} is "at":
        add ((cs_pay({_role}, "at") - {@bet}) * {_mu}) to {casino::st::%{_sk}%::gain}
        if {casino::st::%{_sk}%::ken} > 0:
            remove 1 from {casino::st::%{_sk}%::ken}
            if chance of 27%:
                add 1 to {casino::st::%{_sk}%::vs}
                add "vstock" to {_ev::*}
        if {_role} is "wcherry":
            if chance of 10%:
                add 5 to {casino::st::%{_sk}%::atl}
                set {-cs::uw::%{_u}%} to 5
                add "uwa" to {_ev::*}
        else if {_role} is "suika":
            if chance of 15%:
                add 10 to {casino::st::%{_sk}%::atl}
                set {-cs::uw::%{_u}%} to 10
                add "uwa" to {_ev::*}
        else if {_role} is "scherry":
            if chance of 30%:
                set {casino::st::%{_sk}%::ken} to 2
                add "kenin" to {_ev::*}
        else if {_role} is "chance":
            if chance of 5%:
                set {_d} to cs_drive()
                add {_d} to {casino::st::%{_sk}%::atl}
                set {-cs::dr::%{_u}%} to {_d}
                add "drive" to {_ev::*}
            else if chance of 40%:
                set {casino::st::%{_sk}%::ken} to 2
                add "kenin" to {_ev::*}
        else if {_role} is "bar":
            set {casino::st::%{_sk}%::ken} to 2
            add "kenin" to {_ev::*}
        else if {_role} is "red7":
            set {_d} to cs_drive()
            add {_d} to {casino::st::%{_sk}%::atl}
            set {-cs::dr::%{_u}%} to {_d}
            add "drive" to {_ev::*}
        else if {_role} is "nn7":
            add 100 to {casino::st::%{_sk}%::atl}
            add 3 to {casino::st::%{_sk}%::vs}
            add "nn7at" to {_ev::*}
        remove 1 from {casino::st::%{_sk}%::atl}
        if {casino::st::%{_sk}%::atl} <= 0:
            set {casino::st::%{_sk}%::mode} to "jg"
            set {casino::st::%{_sk}%::jg} to 3
            set {-cs::jv::%{_u}%} to false
            if {casino::st::%{_sk}%::vs} > 0:
                remove 1 from {casino::st::%{_sk}%::vs}
                set {casino::st::%{_sk}%::jwin} to true
                set {-cs::jv::%{_u}%} to true
            else:
                set {_jr} to cs_tbl("jn", cs_setv({_p}))
                if {casino::st::%{_sk}%::sup} is true:
                    set {_jr} to cs_tbl("jsup", cs_setv({_p}))
                set {casino::st::%{_sk}%::jwin} to false
                if chance of {_jr}%:
                    set {casino::st::%{_sk}%::jwin} to true
            add "jgin" to {_ev::*}
        return {_ev::*}
    # ---------- 覚醒ジャッジ (3G) ----------
    if {_m} is "jg":
        add ((cs_pay({_role}, "jg") - {@bet}) * {_mu}) to {casino::st::%{_sk}%::gain}
        remove 1 from {casino::st::%{_sk}%::jg}
        if {casino::st::%{_sk}%::jg} <= 0:
            if {casino::st::%{_sk}%::jwin} is true:
                add "jgwin" to {_ev::*}
                if {casino::st::%{_sk}%::sup} is false:
                    add 1 to {casino::st::%{_sk}%::vl}
                    if {casino::st::%{_sk}%::vl} >= 3:
                        set {casino::st::%{_sk}%::sup} to true
                        add 1 to {casino::stat::%{_u}%::sup}
                        add "super" to {_ev::*}
                set {_extra} to 0
                set {_c} to cs_tbl("drive", cs_setv({_p}))
                if chance of {_c}%:
                    set {_extra} to cs_drive()
                    set {-cs::dr::%{_u}%} to {_extra}
                    add "drive" to {_ev::*}
                cs_atgo({_p}, false, cs_setlen() + {_extra}, 0, true)
            else:
                cs_atend({_p})
                add "jglose" to {_ev::*}
        return {_ev::*}
    return {_ev::*}

# ============================================================
#  演出 (メダルの払い出し・チャレンジ・ボーナス・ラッシュ)
# ============================================================

function cs_hits(p: player, n: number):
    loop {_n} times:
        cs_snd({_p}, "cz_hit", 1, 0.9 + (loop-number) * 0.08)
        cs_mfx({_p}, "hit")
        cs_flash({_p}, "red", "off", 2, 2)
        wait cs_wt({_p}, 8)

# 結果発表のあとで 表示を最新にする
function cs_reveal(p: player):
    delete {-cs::hold::%uuid of {_p}%}
    cs_draw({_p})

function cs_fx(p: player, role: text, pay: number, ev: texts):
    set {_u} to uuid of {_p}
    set {_sk} to cs_key({_p})
    set {-cs::busy::%{_u}%} to true
    cs_btns({_p})
    # 払い出し
    if {_pay} > 0:
        set {_ln} to ""
        if {-cs::line::%{_u}%} is set:
            if {-cs::line::%{_u}%} >= 0:
                set {_ln} to " &7(%cs_linename({-cs::line::%{_u}%})%)"
        cs_bar_msg({_p}, "%cs_rolename({_role})%%{_ln}% &6+%{_pay}%枚 &8| &6クレジット %cs_med({_p})%枚")
        if {_pay} >= 6:
            cs_snd({_p}, "win_small", 0.8, 1)
            cs_mfx({_p}, "pay")
        set {_k} to {_pay}
        if {_k} > 9:
            set {_k} to 9
        if cs_fast({_p}) is true:
            set {_k} to 1
        loop {_k} times:
            cs_snd({_p}, "coin", 0.7, 0.9 + (loop-number) * 0.04)
            cs_btns({_p})
            wait cs_wt({_p}, 1)
    else if cs_flashy({_role}) is true:
        cs_bar_msg({_p}, cs_rolename({_role}))
    else if cs_slotgui({_p}) is not set:
        cs_bar_msg({_p}, "&6クレジット %cs_med({_p})%枚")
    # 結果発表のない演出は、すぐ表示を更新
    set {_wait} to false
    loop {_ev::*}:
        if loop-value is "czwin" or "czlose" or "bbwin" or "bblose" or "rbwin" or "rblose" or "jgwin" or "jglose":
            set {_wait} to true
    if {_wait} is false:
        cs_reveal({_p})
    loop {_ev::*}:
        set {_e} to loop-value
        # ---- 通常時 ----
        if {_e} is "cycle":
            cs_snd({_p}, "tier_up", 0.6, 0.8)
            cs_bar_msg({_p}, "&e周期 %{casino::st::%{_sk}%::cyc} - 1% 到達 &7… チャレンジならず &8(周期 %{casino::st::%{_sk}%::cyc}%/6 へ)")
            wait cs_wt({_p}, 10)
        else if {_e} is "cyclecz":
            cs_title({_p}, "&e&l周期 %{-cs::cyc::%{_u}%}% 到達!", "&f覚醒チャレンジ 突入", 30)
            wait cs_wt({_p}, 16)
        else if {_e} is "zonein":
            cs_snd({_p}, "uwanose", 1, 1)
            cs_mfx({_p}, "uwa")
            cs_title({_p}, "&b&l覚醒ゾーン", "&f5G・ポイント大量獲得のチャンス", 30)
            cs_flash({_p}, "gold", "purple", 8, 3)
            wait cs_wt({_p}, 16)
        else if {_e} is "zonenext":
            cs_snd({_p}, "tier_up", 1, 1)
            cs_bar_msg({_p}, "&b&l覚醒ゾーン 継続! &f%{casino::st::%{_sk}%::zs}%セット目 &7(10セットで覚醒ボーナス)")
            wait cs_wt({_p}, 10)
        else if {_e} is "zoneend":
            cs_bar_msg({_p}, "&7覚醒ゾーン 終了")
        else if {_e} is "zonebb":
            cs_title({_p}, "&b&l覚醒ゾーン 10セット!!", "&f覚醒ボーナス 確定", 30)
            wait cs_wt({_p}, 20)
        else if {_e} is "barin":
            cs_snd({_p}, "kyuin", 1, 1)
            cs_mfx({_p}, "kyuin")
            cs_title({_p}, "&6&lBARドライブ", "&f8G・覚醒チャレンジ高確率", 30)
