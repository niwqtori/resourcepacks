            wait cs_wt({_p}, 40)
            cs_bgmsync({_p})
        else if {_e} is "bbup":
            cs_snd({_p}, "tier_up", 1, 1.1)
            cs_mfx({_p}, "tierup")
            cs_bar_msg({_p}, "&e&l共闘! &fラッシュ期待度 %cs_stars(cs_bbshow({_sk}))%")
            wait cs_wt({_p}, 8)
        else if {_e} is "bbwin" or "rbwin":
            wait cs_wt({_p}, 6)
            cs_bgmstop({_p})
            cs_snd({_p}, "reach", 1, 1)
            if {_e} is "bbwin":
