            cs_hits({_p}, 3)
            wait cs_wt({_p}, 24)
            cs_snd({_p}, "cz_win", 1, 1)
            cs_mfx({_p}, "win")
            cs_title({_p}, "&6&l勝利!!", "&d&lNoName ラッシュ 突入!", 40)
            wait cs_wt({_p}, 30)
        else if {_e} is "bblose" or "rblose":
            wait cs_wt({_p}, 6)
            cs_bgmstop({_p})
            cs_snd({_p}, "reach", 1, 1)
            cs_title({_p}, "&c&l最終決戦!", "&7…", 40)
